  ACTIVE
  SUSPENDED
  TERMINATED
}

/// Commission earning type
enum CommissionType {
  REFERRAL
  RESALE
  RENEWAL
  EXPANSION
}

/// Commission status lifecycle
enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CLAWED_BACK
}

/// Payout batch status
enum PayoutStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

/// MDF (Marketing Development Fund) request status
enum MdfStatus {
  SUBMITTED
  APPROVED
  REJECTED
  UTILIZED
  EXPIRED
}

/// Marketplace listing status
enum ListingStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  REJECTED
  ARCHIVED
}

/// Marketplace listing type
enum ListingType {
  APP
  SERVICE
  INTEGRATION
  TEMPLATE
}

// ============================================================================
// Warehouse — Physical stock storage locations
// ============================================================================
model Warehouse {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  /// Short code (e.g., "WH-MAIN")
  code        String   @db.VarChar(30)
  name        String   @db.VarChar(255)
  address     String?  @db.Text
  city        String?  @db.VarChar(100)
  state       String?  @db.VarChar(100)
  pincode     String?  @db.VarChar(20)
  contact_person String? @db.VarChar(255)
  contact_phone  String? @db.VarChar(30)
  is_default  Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // --- Relations ---
  tenant          Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  stock_movements StockMovement[]
  stock_items     StockItem[]
  purchase_orders PurchaseOrder[]
  sales_orders    SalesOrder[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@map("warehouses")
}

// ============================================================================
// Unit of Measure — Units (kg, pcs, ltrs, etc.)
// ============================================================================
model UnitOfMeasure {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  /// Short code (e.g., "KG", "PCS", "LTR")
  code        String   @db.VarChar(20)
  name        String   @db.VarChar(100)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // --- Relations ---
  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@map("units_of_measure")
}

// ============================================================================
// Product Category — Hierarchical product classification
// ============================================================================
model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  parent_id   String?  @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @db.VarChar(255)
  description String?  @db.Text
  image_url   String?  @db.VarChar(500)
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // --- Relations ---
  tenant   Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@index([parent_id])
  @@map("product_categories")
}

// ============================================================================
// Product — Goods and Services
// ============================================================================
model Product {
  id                String      @id @default(uuid()) @db.Uuid
  tenant_id         String      @db.Uuid
  /// Unique product identifier (e.g., "SKU-0001")
  sku               String      @db.VarChar(50)
  name              String      @db.VarChar(255)
  description       String?     @db.Text
  product_type      ProductType @default(GOODS)
  category_id       String?     @db.Uuid
  uom_id            String?     @db.Uuid
  /// HSN/SAC code for GST
  hsn_sac_code      String?     @db.VarChar(20)
  /// Selling price (MRP or default)
  selling_price     Decimal     @default(0) @db.Decimal(14, 2)
  /// Purchase/cost price
  cost_price        Decimal     @default(0) @db.Decimal(14, 2)
  /// GST tax rate percentage
  tax_rate          Decimal     @default(0) @db.Decimal(5, 2)
  /// Opening stock quantity
  opening_stock     Decimal     @default(0) @db.Decimal(14, 3)
  /// Minimum stock level before alert
  reorder_level     Decimal     @default(0) @db.Decimal(14, 3)
  /// Ideal reorder quantity
  reorder_quantity  Decimal     @default(0) @db.Decimal(14, 3)
  /// Product image URL
  image_url         String?     @db.VarChar(500)
  /// Barcode / EAN
  barcode           String?     @db.VarChar(50)
  /// Brand / Manufacturer
  brand             String?     @db.VarChar(255)
  /// Weight in kg (for shipping)
  weight            Decimal?    @db.Decimal(10, 3)
  /// Arbitrary extra metadata
  metadata          Json?
  is_active         Boolean     @default(true)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  // --- Relations ---
  tenant               Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category             ProductCategory?     @relation(fields: [category_id], references: [id], onDelete: SetNull)
  uom                  UnitOfMeasure?       @relation(fields: [uom_id], references: [id], onDelete: SetNull)
  stock_items          StockItem[]
  stock_movements      StockMovement[]
  purchase_order_items PurchaseOrderItem[]
  sales_order_items    SalesOrderItem[]

  @@unique([tenant_id, sku])
  @@index([tenant_id])
  @@index([category_id])
  @@map("products")
}

// ============================================================================
// Stock Item — Current stock level per product per warehouse
// ============================================================================
model StockItem {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  product_id   String   @db.Uuid
  warehouse_id String   @db.Uuid
  /// Current available quantity
  quantity     Decimal  @default(0) @db.Decimal(14, 3)
  /// Reserved (allocated to pending orders)
  reserved     Decimal  @default(0) @db.Decimal(14, 3)
  updated_at   DateTime @updatedAt

  // --- Relations ---
  tenant    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([product_id, warehouse_id])
  @@index([tenant_id])
  @@map("stock_items")
}

// ============================================================================
// Stock Movement — Every stock in/out is recorded
// ============================================================================
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  tenant_id       String            @db.Uuid
  product_id      String            @db.Uuid
  warehouse_id    String            @db.Uuid
  /// Movement type
  movement_type   StockMovementType
  /// Positive for IN, negative for OUT
  quantity        Decimal           @db.Decimal(14, 3)
  /// Reference document (PO#, SO#, etc.)
  reference_type  String?           @db.VarChar(50)
  reference_id    String?           @db.Uuid
  reference_number String?          @db.VarChar(50)
  /// Notes / reason
  notes           String?           @db.Text
  /// Who performed this movement
  performed_by    String?           @db.Uuid
  movement_date   DateTime          @default(now())
  created_at      DateTime          @default(now())

  // --- Relations ---
  tenant    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [product_id], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)

  @@index([tenant_id])
  @@index([product_id])
  @@index([warehouse_id])
  @@index([movement_type])
  @@map("stock_movements")
}

// ============================================================================
// Purchase Order — Procurement from vendors
// ============================================================================
model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  tenant_id         String              @db.Uuid
  /// Auto-generated reference (e.g., "PO-2026-0001")
  po_number         String              @db.VarChar(50)
  /// Vendor (references Contact or Customer, stored as text for flexibility)
  vendor_name       String              @db.VarChar(255)
  vendor_id         String?             @db.Uuid
  warehouse_id      String?             @db.Uuid
  order_date        DateTime            @db.Date
  expected_delivery DateTime?           @db.Date
  status            PurchaseOrderStatus @default(DRAFT)
  /// Subtotal before tax
  subtotal          Decimal             @default(0) @db.Decimal(14, 2)
  /// Total tax amount
  tax_amount        Decimal             @default(0) @db.Decimal(14, 2)
  /// Discount amount
  discount_amount   Decimal             @default(0) @db.Decimal(14, 2)
  /// Grand total
  total_amount      Decimal             @default(0) @db.Decimal(14, 2)
  /// Internal notes
  notes             String?             @db.Text
  /// Vendor terms / payment terms
  terms             String?             @db.Text
  created_by        String?             @db.Uuid
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  // --- Relations ---
  tenant    Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  warehouse Warehouse?          @relation(fields: [warehouse_id], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]

  @@unique([tenant_id, po_number])
  @@index([tenant_id])
  @@index([status])
  @@map("purchase_orders")
}

// ============================================================================
// Purchase Order Item — Line items of a PO
// ============================================================================
model PurchaseOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchase_order_id String  @db.Uuid
  product_id       String   @db.Uuid
  description      String?  @db.VarChar(500)
  quantity         Decimal  @db.Decimal(14, 3)
  unit_price       Decimal  @db.Decimal(14, 2)
  tax_rate         Decimal  @default(0) @db.Decimal(5, 2)
  tax_amount       Decimal  @default(0) @db.Decimal(14, 2)
  discount_percent Decimal  @default(0) @db.Decimal(5, 2)
  line_total       Decimal  @db.Decimal(14, 2)
  /// Quantity received so far
  received_qty     Decimal  @default(0) @db.Decimal(14, 3)
  sort_order       Int      @default(0)

  // --- Relations ---
  purchase_order PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([purchase_order_id])
  @@map("purchase_order_items")
}

// ============================================================================
// Sales Order — Orders from customers
// ============================================================================
model SalesOrder {
  id                String           @id @default(uuid()) @db.Uuid
  tenant_id         String           @db.Uuid
  /// Auto-generated reference (e.g., "SO-2026-0001")
  so_number         String           @db.VarChar(50)
  customer_id       String?          @db.Uuid
  customer_name     String           @db.VarChar(255)
  warehouse_id      String?          @db.Uuid
  order_date        DateTime         @db.Date
  delivery_date     DateTime?        @db.Date
  status            SalesOrderStatus @default(DRAFT)
  /// Subtotal before tax
  subtotal          Decimal          @default(0) @db.Decimal(14, 2)
  /// Total tax amount
  tax_amount        Decimal          @default(0) @db.Decimal(14, 2)
  /// Discount amount
  discount_amount   Decimal          @default(0) @db.Decimal(14, 2)
  /// Grand total
  total_amount      Decimal          @default(0) @db.Decimal(14, 2)
  /// Shipping address
  shipping_address  String?          @db.Text
  /// Internal notes
  notes             String?          @db.Text
  created_by        String?          @db.Uuid
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  // --- Relations ---
  tenant    Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer  Customer?        @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  warehouse Warehouse?       @relation(fields: [warehouse_id], references: [id], onDelete: SetNull)
  items     SalesOrderItem[]

  @@unique([tenant_id, so_number])
  @@index([tenant_id])
  @@index([customer_id])
  @@index([status])
  @@map("sales_orders")
}

// ============================================================================
// Sales Order Item — Line items of an SO
// ============================================================================
model SalesOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  sales_order_id  String   @db.Uuid
  product_id      String   @db.Uuid
  description     String?  @db.VarChar(500)
  quantity        Decimal  @db.Decimal(14, 3)
  unit_price      Decimal  @db.Decimal(14, 2)
  tax_rate        Decimal  @default(0) @db.Decimal(5, 2)
  tax_amount      Decimal  @default(0) @db.Decimal(14, 2)
  discount_percent Decimal @default(0) @db.Decimal(5, 2)
  line_total      Decimal  @db.Decimal(14, 2)
  /// Quantity shipped so far
  shipped_qty     Decimal  @default(0) @db.Decimal(14, 3)
  sort_order      Int      @default(0)

  // --- Relations ---
  sales_order SalesOrder @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([sales_order_id])
  @@map("sales_order_items")
}

// ==============================================================================
// ==============================================================================
//
//  PHASE 5: E-LEARNING & COMMUNITY
//
// ==============================================================================
// ==============================================================================

// ============================================================================
// Course Category — Organise courses into categories
// ============================================================================
model CourseCategory {
  id          String  @id @default(uuid()) @db.Uuid
  tenant_id   String  @db.Uuid
  name        String  @db.VarChar(255)
  slug        String  @db.VarChar(255)
  description String? @db.Text
  /// Parent for hierarchical categories
  parent_id   String? @db.Uuid
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // --- Relations ---
  tenant   Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent   CourseCategory?  @relation("CourseCategoryTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children CourseCategory[] @relation("CourseCategoryTree")
  courses  Course[]

  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@map("course_categories")
}

// ============================================================================
// Course — A course with modules and lessons
// ============================================================================
model Course {
  id                  String         @id @default(uuid()) @db.Uuid
  tenant_id           String         @db.Uuid
  /// Course title
  title               String         @db.VarChar(255)
  /// URL-friendly slug
  slug                String         @db.VarChar(255)
  /// Rich text description
  description         String?        @db.Text
  /// Short summary for cards/lists
  short_description   String?        @db.VarChar(500)
  /// Thumbnail URL
  thumbnail_url       String?        @db.VarChar(500)
  /// Course category
  category_id         String?        @db.Uuid
  /// Difficulty level
  level               CourseLevel    @default(BEGINNER)
  /// Total duration in minutes
  duration_minutes    Int            @default(0)
  /// Instructor (references User)
  instructor_id       String?        @db.Uuid
  /// Price (0 for free)
  price               Decimal        @default(0) @db.Decimal(10, 2)
  /// Whether course is visible to learners
  is_published        Boolean        @default(false)
  /// Enrollment type
  enrollment_type     EnrollmentType @default(OPEN)
  /// Whether a certificate is awarded on completion
  certificate_enabled Boolean        @default(false)
  /// Minimum quiz score required for certificate (0-100)
  passing_score       Int            @default(70)
  /// Maximum number of enrollments (null = unlimited)
  max_enrollments     Int?
  /// Course tags for search
  tags                Json           @default("[]") @db.JsonB
  /// Extra metadata (prerequisites, objectives, etc.)
  metadata            Json           @default("{}") @db.JsonB
  is_active           Boolean        @default(true)
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  // --- Relations ---
  tenant      Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category    CourseCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  instructor  User?           @relation("CourseInstructor", fields: [instructor_id], references: [id], onDelete: SetNull)
  modules     CourseModule[]
  enrollments Enrollment[]
  certificates Certificate[]

  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@index([category_id])
  @@index([is_published])
  @@map("courses")
}

// ============================================================================
// Course Module — Sections within a course
// ============================================================================
model CourseModule {
  id          String  @id @default(uuid()) @db.Uuid
  course_id   String  @db.Uuid
  /// Module title
  title       String  @db.VarChar(255)
  description String? @db.Text
  sort_order  Int     @default(0)
  /// Total duration in minutes
  duration_minutes Int @default(0)
  is_active   Boolean @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // --- Relations ---
  course  Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([course_id])
  @@map("course_modules")
}

// ============================================================================
// Lesson — Individual pieces of content within a module
// ============================================================================
model Lesson {
  id           String     @id @default(uuid()) @db.Uuid
  module_id    String     @db.Uuid
  /// Lesson title
  title        String     @db.VarChar(255)
  /// Content type
  lesson_type  LessonType @default(TEXT)
  /// Rich text/HTML content for text lessons
  content      String?    @db.Text
  /// Video URL or file path
  video_url    String?    @db.VarChar(500)
  /// Duration in minutes
  duration_minutes Int    @default(0)
  sort_order   Int        @default(0)
  /// Whether lesson is available for preview without enrollment
  is_preview   Boolean    @default(false)
  is_active    Boolean    @default(true)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  // --- Relations ---
  module     CourseModule     @relation(fields: [module_id], references: [id], onDelete: Cascade)
  quiz       Quiz?
  progress   LessonProgress[]

  @@index([module_id])
  @@map("lessons")
}

// ============================================================================
// Quiz — Assessment attached to a lesson
// ============================================================================
model Quiz {
  id             String  @id @default(uuid()) @db.Uuid
  lesson_id      String  @unique @db.Uuid
  /// Quiz title
  title          String  @db.VarChar(255)
  description    String? @db.Text
  /// Time limit in minutes (null = no limit)
  time_limit_min Int?
  /// Minimum score to pass (0-100)
  passing_score  Int     @default(70)
  /// Number of allowed attempts (null = unlimited)
  max_attempts   Int?
  /// Randomise question order
  shuffle_questions Boolean @default(false)
  is_active      Boolean @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // --- Relations ---
  lesson    Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

// ============================================================================
// Quiz Question — Individual questions within a quiz
// ============================================================================
model QuizQuestion {
  id              String       @id @default(uuid()) @db.Uuid
  quiz_id         String       @db.Uuid
  /// Question text
  question_text   String       @db.Text
  question_type   QuestionType @default(MULTIPLE_CHOICE)
  /// JSON array of option objects [{label, value, is_correct}]
  options         Json         @default("[]") @db.JsonB
  /// Correct answer (for short answer / essay grading reference)
  correct_answer  String?      @db.Text
  /// Points for this question
  points          Int          @default(1)
  /// Explanation shown after answering
  explanation     String?      @db.Text
  sort_order      Int          @default(0)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  // --- Relations ---
  quiz Quiz @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@index([quiz_id])
  @@map("quiz_questions")
}

// ============================================================================
// Enrollment — Tracks a user's registration in a course
// ============================================================================
model Enrollment {
  id              String           @id @default(uuid()) @db.Uuid
  tenant_id       String           @db.Uuid
  user_id         String           @db.Uuid
  course_id       String           @db.Uuid
  status          EnrollmentStatus @default(ENROLLED)
  /// Overall progress percentage (0-100)
  progress_pct    Int              @default(0)
  /// When the user started the course
  started_at      DateTime?
  /// When the user completed the course
  completed_at    DateTime?
  /// Expiry date for time-limited access
  expires_at      DateTime?
  /// Last time user accessed any content
  last_accessed_at DateTime?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  // --- Relations ---
  tenant          Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lesson_progress LessonProgress[]

  @@unique([user_id, course_id])
  @@index([tenant_id])
  @@index([user_id])
  @@index([course_id])
  @@index([status])
  @@map("enrollments")
}

// ============================================================================
// Lesson Progress — Tracks per-lesson completion for each enrollment
// ============================================================================
model LessonProgress {
  id            String   @id @default(uuid()) @db.Uuid
  enrollment_id String   @db.Uuid
  lesson_id     String   @db.Uuid
  /// Whether the lesson is completed
  is_completed  Boolean  @default(false)
  /// Time spent on this lesson in seconds
  time_spent_sec Int     @default(0)
  completed_at  DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // --- Relations ---
  enrollment Enrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([enrollment_id, lesson_id])
  @@index([enrollment_id])
  @@map("lesson_progress")
}

// ============================================================================
// Quiz Attempt — A user's attempt at a quiz
// ============================================================================
model QuizAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  quiz_id      String   @db.Uuid
  user_id      String   @db.Uuid
  /// JSON array of answers [{question_id, answer, is_correct, points_awarded}]
  answers      Json     @default("[]") @db.JsonB
  /// Total score achieved
  score        Int      @default(0)
  /// Maximum possible score
  max_score    Int      @default(0)
  /// Percentage score
  score_pct    Int      @default(0)
  passed       Boolean  @default(false)
  /// Time taken in seconds
  time_taken_sec Int    @default(0)
  started_at   DateTime @default(now())
  completed_at DateTime?

  // --- Relations ---
  quiz Quiz @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@index([quiz_id])
  @@index([user_id])
  @@map("quiz_attempts")
}

// ============================================================================
// Certificate — Issued on course completion
// ============================================================================
model Certificate {
  id               String            @id @default(uuid()) @db.Uuid
  tenant_id        String            @db.Uuid
  user_id          String            @db.Uuid
  course_id        String            @db.Uuid
  /// Unique certificate number (e.g., "CERT-2026-0001")
  certificate_no   String            @db.VarChar(50)
  /// Recipient name (as displayed on cert)
  recipient_name   String            @db.VarChar(255)
  status           CertificateStatus @default(ISSUED)
  issued_at        DateTime          @default(now())
  /// Expiry date (null = no expiry)
  expires_at       DateTime?
  /// Optional PDF URL
  pdf_url          String?           @db.VarChar(500)
  /// Extra metadata (score, grade, etc.)
  metadata         Json              @default("{}") @db.JsonB
  created_at       DateTime          @default(now())

  // --- Relations ---
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, certificate_no])
  @@index([tenant_id])
  @@index([user_id])
  @@index([course_id])
  @@map("certificates")
}

// ============================================================================
// Forum Category — Top-level grouping for community discussions
// ============================================================================
model ForumCategory {
  id          String  @id @default(uuid()) @db.Uuid
  tenant_id   String  @db.Uuid
  name        String  @db.VarChar(255)
  slug        String  @db.VarChar(255)
  description String? @db.Text
  /// Icon identifier (e.g., solar icon name)
  icon        String? @db.VarChar(100)
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // --- Relations ---
  tenant Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  posts  ForumPost[]

  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@map("forum_categories")
}

// ============================================================================
// Forum Post — A discussion thread / question / announcement
// ============================================================================
model ForumPost {
  id              String           @id @default(uuid()) @db.Uuid
  tenant_id       String           @db.Uuid
  category_id     String?          @db.Uuid
  author_id       String           @db.Uuid
  /// Post title
  title           String           @db.VarChar(500)
  slug            String           @db.VarChar(500)
  /// Rich text content
  content         String           @db.Text
  post_type       PostType         @default(DISCUSSION)
  /// Moderation status
  moderation      ModerationStatus @default(APPROVED)
  /// Whether this is a pinned/sticky post
  is_pinned       Boolean          @default(false)
  /// Whether the post is locked for new replies
  is_locked       Boolean          @default(false)
  /// Number of views
  view_count      Int              @default(0)
  /// Upvote count (cached for performance)
  upvote_count    Int              @default(0)
  /// Reply count (cached)
  reply_count     Int              @default(0)
  /// Tags for filtering
  tags            Json             @default("[]") @db.JsonB
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  // --- Relations ---
  tenant   Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category ForumCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  author   User           @relation(fields: [author_id], references: [id], onDelete: Cascade)
  replies  ForumReply[]

  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@index([category_id])
  @@index([author_id])
  @@index([post_type])
  @@map("forum_posts")
}

// ============================================================================
// Forum Reply — Replies to a forum post
// ============================================================================
model ForumReply {
  id            String           @id @default(uuid()) @db.Uuid
  post_id       String           @db.Uuid
  author_id     String           @db.Uuid
  /// Parent reply for threaded replies (null = top-level reply)
  parent_id     String?          @db.Uuid
  content       String           @db.Text
  moderation    ModerationStatus @default(APPROVED)
  /// Whether this reply is marked as the accepted answer (for Q&A posts)
  is_accepted   Boolean          @default(false)
  upvote_count  Int              @default(0)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  // --- Relations ---
  post     ForumPost    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  author   User         @relation(fields: [author_id], references: [id], onDelete: Cascade)
  parent   ForumReply?  @relation("ReplyThread", fields: [parent_id], references: [id], onDelete: SetNull)
  children ForumReply[] @relation("ReplyThread")

  @@index([post_id])
  @@index([author_id])
  @@map("forum_replies")
}

// ==============================================================================
// PHASE 6: PARTNER PROGRAM & MARKETPLACE
// ==============================================================================

// ============================================================================
// Partner — Registered partner companies in the partner program
// ============================================================================
model Partner {
  id                 String        @id @default(uuid()) @db.Uuid
  tenant_id          String        @db.Uuid
  /// Auto-generated partner reference (e.g., "PTR-2026-0001")
  partner_code       String        @db.VarChar(50)
  /// Partner company name
  company_name       String        @db.VarChar(255)
  /// Primary contact name at the partner company
  contact_name       String        @db.VarChar(255)
  /// Primary contact email
  contact_email      String        @db.VarChar(255)
  /// Primary contact phone
  contact_phone      String?       @db.VarChar(20)
  /// Partner website
  website            String?       @db.VarChar(500)
  /// Type of partnership
  partner_type       PartnerType   @default(REFERRAL)
  /// Current tier level
  tier               PartnerTier   @default(BRONZE)
  /// Lifecycle status
  status             PartnerStatus @default(PENDING)
  /// Default commission percentage (0-100)
  commission_rate    Decimal       @default(10) @db.Decimal(5, 2)
  /// Assigned internal partner manager
  partner_manager_id String?       @db.Uuid
  /// When partner agreement was signed
  agreement_signed_at DateTime?
  /// Annual marketing development fund budget in INR
  mdf_budget         Decimal       @default(0) @db.Decimal(14, 2)
  /// Industry/solution specializations
  specializations    Json          @default("[]") @db.JsonB
  /// Earned certifications
  certifications     Json          @default("[]") @db.JsonB
  /// Whether partner has portal access
  portal_access      Boolean       @default(true)
  /// Address
  address            String?       @db.Text
  /// City
  city               String?       @db.VarChar(100)
  /// State
  state              String?       @db.VarChar(100)
  /// Pincode
  pincode            String?       @db.VarChar(20)
  /// GSTIN for Indian partners
  gstin              String?       @db.VarChar(20)
  /// PAN for TDS deduction
  pan                String?       @db.VarChar(15)
  /// Bank account details for payouts (encrypted at app level)
  bank_details       Json?         @db.JsonB
  /// Additional notes
  notes              String?       @db.Text
  /// Soft delete
  is_deleted         Boolean       @default(false)
  deleted_at         DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  // --- Relations ---
  tenant             Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  partner_manager    User?         @relation("PartnerManager", fields: [partner_manager_id], references: [id], onDelete: SetNull)
  commissions        Commission[]
  payouts            PartnerPayout[]
  mdf_requests       MdfRequest[]
  marketplace_listings MarketplaceListing[]

  @@unique([tenant_id, partner_code])
  @@unique([tenant_id, contact_email])
  @@index([tenant_id])
  @@index([status])
  @@index([partner_type])
  @@index([tier])
  @@map("partners")
}

// ============================================================================
// Commission — Commission records for partner earnings
// ============================================================================
model Commission {
  id                String           @id @default(uuid()) @db.Uuid
  tenant_id         String           @db.Uuid
  /// Reference to the earning partner
  partner_id        String           @db.Uuid
  /// Auto-generated commission reference (e.g., "COM-2026-0001")
  commission_no     String           @db.VarChar(50)
  /// Type of commission (referral, resale, renewal, expansion)
  commission_type   CommissionType   @default(REFERRAL)
  /// Related deal / order reference description
  deal_reference    String?          @db.VarChar(255)
  /// Related deal ID (optional FK to Deal)
  deal_id           String?          @db.Uuid
  /// Base amount the commission is calculated on (deal value)
  base_amount       Decimal          @db.Decimal(14, 2)
  /// Commission rate applied (percentage)
  commission_rate   Decimal          @db.Decimal(5, 2)
  /// Calculated commission amount
  commission_amount Decimal          @db.Decimal(14, 2)
  /// Currency
  currency          String           @default("INR") @db.VarChar(3)
  /// Commission lifecycle status
  status            CommissionStatus @default(PENDING)
  /// Whether subject to clawback
  clawback_eligible Boolean          @default(true)
  /// Clawback eligibility end date
  clawback_until    DateTime?
  /// Reference to payout batch
  payout_id         String?          @db.Uuid
  /// When commission was paid
  paid_at           DateTime?
  /// Approval notes
  approval_notes    String?          @db.Text
  /// Who approved the commission
  approved_by       String?          @db.VarChar(255)
  /// Date of approval
  approved_at       DateTime?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  // --- Relations ---
  tenant            Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  partner           Partner          @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  payout            PartnerPayout?   @relation(fields: [payout_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, commission_no])
  @@index([tenant_id])
  @@index([partner_id])
  @@index([status])
  @@index([payout_id])
  @@map("commissions")
}

// ============================================================================
// PartnerPayout — Batch payout processing for partner commissions
// ============================================================================
model PartnerPayout {
  id              String       @id @default(uuid()) @db.Uuid
  tenant_id       String       @db.Uuid
  /// Reference to the partner being paid out
  partner_id      String       @db.Uuid
  /// Auto-generated payout reference (e.g., "PAY-2026-0001")
  payout_no       String       @db.VarChar(50)
  /// Payout period start date
  period_start    DateTime
  /// Payout period end date
  period_end      DateTime
  /// Total payout amount (sum of commissions)
  total_amount    Decimal      @db.Decimal(14, 2)
  /// TDS deducted amount
  tds_amount      Decimal      @default(0) @db.Decimal(14, 2)
  /// Net amount after TDS
  net_amount      Decimal      @db.Decimal(14, 2)
  /// Currency
  currency        String       @default("INR") @db.VarChar(3)
  /// Payout status
  status          PayoutStatus @default(DRAFT)
  /// Payment method (bank transfer, cheque, etc.)
  payment_method  String?      @db.VarChar(50)
  /// Payment reference / UTR number
  payment_ref     String?      @db.VarChar(100)
  /// When the payout was processed
  processed_at    DateTime?
  /// Who initiated the payout
  processed_by    String?      @db.VarChar(255)
  /// Notes
  notes           String?      @db.Text
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  // --- Relations ---
  tenant          Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  partner         Partner      @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  commissions     Commission[]

  @@unique([tenant_id, payout_no])
  @@index([tenant_id])
  @@index([partner_id])
  @@index([status])
  @@map("partner_payouts")
}

// ============================================================================
// MdfRequest — Marketing Development Fund requests from partners
// ============================================================================
model MdfRequest {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  partner_id      String    @db.Uuid
  /// Auto-generated request reference (e.g., "MDF-2026-0001")
  request_no      String    @db.VarChar(50)
  /// Title of the MDF request
  title           String    @db.VarChar(255)
  /// Description of marketing activity
  description     String    @db.Text
  /// Requested amount in INR
  requested_amount Decimal  @db.Decimal(14, 2)
  /// Approved amount (may differ from requested)
  approved_amount  Decimal? @db.Decimal(14, 2)
  /// Request status
  status          MdfStatus @default(SUBMITTED)
  /// Activity date range start
  activity_start  DateTime?
  /// Activity date range end
  activity_end    DateTime?
  /// Supporting documents / receipts URLs
  attachments     Json      @default("[]") @db.JsonB
  /// Approval notes
  approval_notes  String?   @db.Text
  /// Utilization proof / report
  utilization_report String? @db.Text
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // --- Relations ---
  tenant          Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  partner         Partner   @relation(fields: [partner_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, request_no])
  @@index([tenant_id])
  @@index([partner_id])
  @@index([status])
  @@map("mdf_requests")
}

// ============================================================================
// MarketplaceListing — Partner marketplace apps, services, integrations
// ============================================================================
model MarketplaceListing {
  id              String        @id @default(uuid()) @db.Uuid
  tenant_id       String        @db.Uuid
  partner_id      String?       @db.Uuid
  /// Listing title
  title           String        @db.VarChar(255)
  /// URL-friendly slug
  slug            String        @db.VarChar(255)
  /// Short description (for cards)
  short_description String?     @db.VarChar(500)
  /// Full description (rich text)
  description     String        @db.Text
  /// Listing type
  listing_type    ListingType   @default(APP)
  /// Listing status
  status          ListingStatus @default(DRAFT)
  /// Category / tag for filtering
  category        String?       @db.VarChar(100)
  /// Tags for searchability
  tags            Json          @default("[]") @db.JsonB
  /// Logo / icon URL
  logo_url        String?       @db.VarChar(500)
  /// Screenshot URLs
  screenshots     Json          @default("[]") @db.JsonB
  /// Pricing info (free, paid, freemium, contact)
  pricing_model   String?       @db.VarChar(50)
  /// Price if applicable
  price           Decimal?      @db.Decimal(10, 2)
  /// Average rating (cached)
  avg_rating      Decimal       @default(0) @db.Decimal(3, 2)
  /// Total number of reviews
  review_count    Int           @default(0)
  /// Total installs / subscribers
  install_count   Int           @default(0)
  /// External link / documentation URL
  external_url    String?       @db.VarChar(500)
  /// Version number
  version         String?       @db.VarChar(30)
  /// Whether the listing is featured
  is_featured     Boolean       @default(false)
  /// Soft delete
  is_deleted      Boolean       @default(false)
  deleted_at      DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  // --- Relations ---
  tenant          Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  partner         Partner?       @relation(fields: [partner_id], references: [id], onDelete: SetNull)
  reviews         MarketplaceReview[]

  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@index([partner_id])
  @@index([status])
  @@index([listing_type])
  @@map("marketplace_listings")
}

// ============================================================================
// MarketplaceReview — Reviews & ratings for marketplace listings
// ============================================================================
model MarketplaceReview {
  id              String             @id @default(uuid()) @db.Uuid
  tenant_id       String             @db.Uuid
  listing_id      String             @db.Uuid
  reviewer_id     String             @db.Uuid
  /// Rating (1–5)
  rating          Int
  /// Review title
  title           String?            @db.VarChar(255)
  /// Review body
  content         String?            @db.Text
  /// Whether this review has been verified (actual user)
  is_verified     Boolean            @default(false)
  /// Moderation status
  moderation      ModerationStatus   @default(APPROVED)
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  // --- Relations ---
  tenant          Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  listing         MarketplaceListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  reviewer        User               @relation(fields: [reviewer_id], references: [id], onDelete: Cascade)

  @@unique([listing_id, reviewer_id]) // One review per user per listing
  @@index([tenant_id])
  @@index([listing_id])
  @@index([reviewer_id])
  @@map("marketplace_reviews")
}

