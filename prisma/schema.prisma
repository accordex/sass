// ==============================================================================
// SUBSCRIPTION PLANS — Defines available service tiers
// ==============================================================================
// Created in Phase 1 because Tenant references plan_id.
// Extended in Phase 2 with full billing integration.
// ==============================================================================

model SubscriptionPlan {
  id              String   @id @default(uuid()) @db.Uuid
  /// Display name shown to customers (e.g., "Starter", "Professional", "Enterprise")
  plan_name       String   @db.VarChar(100)
  /// Unique code for internal reference and API usage (e.g., "starter", "pro", "enterprise")
  plan_code       String   @unique @db.VarChar(50)
  /// Marketing description of the plan
  description     String?  @db.Text
  /// Monthly subscription price in INR
  monthly_price   Decimal  @db.Decimal(10, 2)
  /// Annual subscription price in INR (typically discounted)
  yearly_price    Decimal  @db.Decimal(10, 2)
  /// JSON object listing included features (e.g., {"crm": true, "hrms": false, "max_invoices": 500})
  features        Json     @default("{}") @db.JsonB
  /// Maximum number of users allowed on this plan
  max_users       Int      @default(5)
  /// Maximum storage in GB
  max_storage_gb  Int      @default(10)
  /// Monthly AI token allowance for this plan
  ai_tokens_limit Int      @default(10000)
  /// Whether this plan is currently offered to new customers
  is_active       Boolean  @default(true)
  /// Display order on pricing page
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // --- Relations ---
  tenants         Tenant[]
  subscriptions   Subscription[]

  @@index([is_active])
  @@map("subscription_plans")
}

// ==============================================================================
// TENANT — Core multi-tenant entity representing a customer organization
// ==============================================================================
// Every business entity (company) that signs up is a Tenant.
// All data in the system is scoped by tenant_id for isolation.
// ==============================================================================

model Tenant {
  id                  String             @id @default(uuid()) @db.Uuid
  /// Unique code used in URLs/subdomains (e.g., "acme-corp")
  tenant_code         String             @unique @db.VarChar(50)
  /// Registered legal company name
  company_name        String             @db.VarChar(255)
  /// Trading name / DBA if different from legal name
  trade_name          String?            @db.VarChar(255)
  /// Primary contact email for the organization
  primary_email       String             @db.VarChar(255)
  /// Primary contact phone number
  phone_number        String             @db.VarChar(20)
  /// Current lifecycle status of the tenant
  status              TenantStatus       @default(TRIAL)
  /// Reference to the subscription plan this tenant is on
  plan_id             String             @db.Uuid
  /// Current billing/subscription status
  subscription_status SubscriptionStatus @default(TRIAL)
  /// When the trial period expires (null if not on trial)
  trial_ends_at       DateTime?
  /// Tenant-specific configuration (branding, GST info, regional preferences, etc.)
  tenant_settings     Json               @default("{}") @db.JsonB
  /// Additional custom metadata for extensibility
  metadata            Json?              @db.JsonB
  /// Soft delete flag — never hard-delete tenant data
  is_deleted          Boolean            @default(false)
  /// When the tenant was soft-deleted
  deleted_at          DateTime?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  // --- Relations ---
  plan                SubscriptionPlan   @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  users               User[]
  roles               Role[]
  settings            Setting[]
  notifications       Notification[]
  audit_logs          AuditLog[]
  ai_usage_logs       AIUsageLog[]
  // Phase 2 relations
  subscriptions       Subscription[]
  platform_invoices   PlatformInvoice[]
  leads               Lead[]
  contacts            Contact[]
  customers           Customer[]
  deals               Deal[]
  pipelines           Pipeline[]
  chart_of_accounts   ChartOfAccount[]
  journal_entries     JournalEntry[]
  sales_invoices      SalesInvoice[]
  purchase_bills      PurchaseBill[]
  payment_receipts    PaymentReceipt[]
  payments_made       PaymentMade[]
  credit_notes        CreditNote[]
  debit_notes         DebitNote[]
  bank_accounts       BankAccount[]
  tax_rates           TaxRate[]
  payment_methods     PaymentMethod[]
  // Phase 3: HRMS & Payroll relations
  departments         Department[]
  designations        Designation[]
  employees           Employee[]
  attendance_records  Attendance[]
  leave_types         LeaveType[]
  leave_balances      LeaveBalance[]
  leave_requests      LeaveRequest[]
  holidays            Holiday[]
  salary_components   SalaryComponent[]
  salary_structures   SalaryStructure[]
  employee_salaries   EmployeeSalary[]
  payroll_runs        PayrollRun[]

  // Phase 4: Inventory & Order Management relations
  warehouses          Warehouse[]
  units_of_measure    UnitOfMeasure[]
  product_categories  ProductCategory[]
  products            Product[]
  stock_items         StockItem[]
  stock_movements     StockMovement[]
  purchase_orders     PurchaseOrder[]
  sales_orders        SalesOrder[]

  // Phase 5: E-Learning & Community relations
  course_categories   CourseCategory[]
  courses             Course[]
  enrollments         Enrollment[]
  certificates        Certificate[]
  forum_categories    ForumCategory[]
  forum_posts         ForumPost[]

  // Phase 6: Partner Program & Marketplace relations
  partners            Partner[]
  commissions         Commission[]
  partner_payouts     PartnerPayout[]
  mdf_requests        MdfRequest[]
  marketplace_listings MarketplaceListing[]
  marketplace_reviews MarketplaceReview[]

  // Phase 7: AI Enhancement & Optimization relations
  ai_agents           AIAgent[]
  ai_conversations    AIConversation[]
  rag_documents       RAGDocument[]
  autonomous_rules    AutonomousRule[]
  autonomous_decisions AutonomousDecision[]
  analytics_dashboards AnalyticsDashboard[]

  @@index([tenant_code])
  @@index([status])
  @@index([subscription_status])
  @@index([is_deleted])
  @@map("tenants")
}

// ==============================================================================
// USER — Individual users within a tenant
// ==============================================================================
// Each user belongs to exactly one tenant. Email is unique within a tenant
// but the same email can exist across different tenants.
// The user model is referenced by HRMS Employee (Phase 3) and Partner (Phase 5).
// ==============================================================================

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// The tenant this user belongs to
  tenant_id          String     @db.Uuid
  /// Login email address (unique within the tenant)
  email              String     @db.VarChar(255)
  /// Mobile number for OTP-based login and SMS notifications
  phone              String?    @db.VarChar(20)
  /// Bcrypt-hashed password — never store plain text
  password_hash      String     @db.VarChar(255)
  /// User's first/given name
  first_name         String     @db.VarChar(100)
  /// User's last/family name
  last_name          String     @db.VarChar(100)
  /// URL to the user's profile picture (stored in S3/CDN)
  avatar_url         String?    @db.VarChar(500)
  /// Account status controlling access
  status             UserStatus @default(PENDING)
  /// Whether the user has verified their email address
  email_verified     Boolean    @default(false)
  /// Whether the user has verified their phone number
  phone_verified     Boolean    @default(false)
  /// Whether two-factor authentication is enabled
  mfa_enabled        Boolean    @default(false)
  /// TOTP secret for 2FA (encrypted at application level)
  mfa_secret         String?    @db.VarChar(255)
  /// Timestamp of the most recent successful login
  last_login_at      DateTime?
  /// Total number of successful logins (for analytics)
  login_count        Int        @default(0)
  /// Consecutive failed login attempts (resets on success)
  failed_login_count Int        @default(0)
  /// Account lockout expiry after too many failed attempts
  locked_until       DateTime?
  /// User preferences: theme, language, notification settings, dashboard layout
  preferences        Json       @default("{}") @db.JsonB
  /// Soft delete flag
  is_deleted         Boolean    @default(false)
  /// When the user was soft-deleted
  deleted_at         DateTime?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  // --- Relations ---
  tenant             Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_roles         UserRole[]
  notifications      Notification[]
  audit_logs         AuditLog[]
  ai_usage_logs      AIUsageLog[]
  /// Settings created/owned by this user (user-level preferences)
  user_settings      Setting[]        @relation("UserSettings")
  // Phase 2: CRM — leads owned by this user (sales rep)
  owned_leads        Lead[]           @relation("LeadOwner")
  lead_activities    LeadActivity[]
  // Phase 2: CRM — deals owned by this user
  owned_deals        Deal[]           @relation("DealOwner")
  // Phase 2: Accounting — journal entries created by this user
  journal_entries    JournalEntry[]
  // Phase 3: HRMS — linked employee record
  employee           Employee?
  // Phase 5: E-Learning — enrollments and instructor roles
  enrollments        Enrollment[]
  instructed_courses Course[]       @relation("CourseInstructor")
  forum_posts        ForumPost[]
  forum_replies      ForumReply[]
  certificates       Certificate[]
  // Phase 6: Partner Program
  managed_partners   Partner[]      @relation("PartnerManager")
  marketplace_reviews MarketplaceReview[]

  // Phase 7: AI Enhancement & Optimization
  ai_conversations   AIConversation[]
  ai_messages        AIMessage[]
  created_dashboards AnalyticsDashboard[] @relation("DashboardCreator")

  @@unique([tenant_id, email]) // Email must be unique within each tenant
  @@index([tenant_id])
  @@index([email])
  @@index([status])
  @@index([is_deleted])
  @@map("users")
}

// ==============================================================================
// RBAC — Role-Based Access Control
// ==============================================================================
// Implements a hierarchical permission model:
//   Role → has many Permissions (via RolePermission junction)
//   User → has many Roles (via UserRole junction)
//   Each RolePermission can have a DataScope (own/team/dept/branch/all)
//   and field-level security (e.g., hide salary field)
//
// System roles (is_system=true) are created by seed and cannot be deleted.
// Tenant-specific roles have a tenant_id and are managed by tenant admins.
// ==============================================================================

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  /// Null for platform-wide system roles; set for tenant-specific roles
  tenant_id   String?   @db.Uuid
  /// Human-readable name (e.g., "Sales Manager", "HR Admin", "Viewer")
  role_name   String    @db.VarChar(100)
  /// Machine-readable code (e.g., "super_admin", "tenant_admin", "sales_manager")
  role_code   String    @db.VarChar(50)
  /// Description of what this role can do
  description String?   @db.Text
  /// System roles (super_admin, tenant_admin) cannot be modified or deleted
  is_system   Boolean   @default(false)
  /// Whether this role is currently assignable
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  // --- Relations ---
  tenant           Tenant?          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@unique([tenant_id, role_code])
  @@index([tenant_id])
  @@index([is_system])
  @@map("roles")
}

/// Permission defines a specific action on a specific resource within a module
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// The entity this permission applies to (e.g., "tenants", "leads", "invoices", "employees")
  resource    String   @db.VarChar(100)
  /// The operation allowed (e.g., "create", "read", "update", "delete", "export", "approve")
  action      String   @db.VarChar(50)
  /// Human-readable description
  description String?  @db.Text
  /// The module this permission belongs to (e.g., "core", "crm", "accounting", "hrms", "elearning", "partner")
  module      String   @db.VarChar(50)
  created_at  DateTime @default(now())

  // --- Relations ---
  role_permissions RolePermission[]

  @@unique([resource, action])
  @@index([module])
  @@map("permissions")
}

/// Junction table connecting roles to permissions with scope and field security
model RolePermission {
  id            String    @id @default(uuid()) @db.Uuid
  role_id       String    @db.Uuid
  permission_id String    @db.Uuid
  /// Controls record visibility: OWN (only their records), TEAM, DEPARTMENT, BRANCH, ALL
  data_scope    DataScope @default(ALL)
  /// Field-level access control (e.g., {"salary": "hidden", "pan_number": "masked"})
  field_access  Json?     @db.JsonB
  created_at    DateTime  @default(now())

  // --- Relations ---
  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

/// Junction table assigning roles to users
model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  role_id     String   @db.Uuid
  /// When this role was assigned to the user
  assigned_at DateTime @default(now())

  // --- Relations ---
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@map("user_roles")
}

// ==============================================================================
// SETTINGS FRAMEWORK — Hierarchical configuration system
// ==============================================================================
// Settings follow inheritance: Platform → Tenant → Module → User
// Platform settings: tenant_id=null, user_id=null
// Tenant settings:   tenant_id=set, user_id=null
// Module settings:   tenant_id=set, module=set, user_id=null
// User settings:     tenant_id=set, user_id=set
// ==============================================================================

model Setting {
  id            String          @id @default(uuid()) @db.Uuid
  /// Null for platform-wide settings
  tenant_id     String?         @db.Uuid
  /// Module code (e.g., "crm", "accounting", "hrms") — null for global settings
  module        String?         @db.VarChar(50)
  /// Null for platform/tenant settings; set for user-specific preferences
  user_id       String?         @db.Uuid
  /// Grouping category (e.g., "ai", "auth", "notifications", "billing", "display")
  category      String          @db.VarChar(100)
  /// Unique setting identifier (e.g., "ai.enabled", "auth.session_timeout")
  setting_key   String          @db.VarChar(255)
  /// The actual value stored as JSONB (can be string, number, boolean, object, array)
  setting_value Json            @db.JsonB
  /// Data type hint for frontend rendering and validation
  value_type    SettingValueType @default(STRING)
  /// Whether the value is encrypted at rest (e.g., API keys, secrets)
  is_encrypted  Boolean         @default(false)
  /// Whether to mask the value in logs, exports, and non-admin UIs
  is_sensitive  Boolean         @default(false)
  /// Array of role codes that can modify this setting (e.g., ["super_admin", "tenant_admin"])
  editable_by   Json            @default("[]") @db.JsonB
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  // --- Relations ---
  tenant Tenant? @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User?   @relation("UserSettings", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, module, user_id, setting_key])
  @@index([tenant_id])
  @@index([category])
  @@index([setting_key])
  @@map("settings")
}

// ==============================================================================
// NOTIFICATION ENGINE — Multi-channel notification system
// ==============================================================================
// Supports Email, SMS, WhatsApp, Push, and In-App notifications.
// Templates define reusable notification content with variable substitution.
// Notifications track delivery status for each individual send.
// ==============================================================================

/// Reusable notification content templates with variable placeholders
model NotificationTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  /// Unique template identifier (e.g., "trial_expiry_reminder", "invoice_payment_received")
  template_code  String              @unique @db.VarChar(100)
  /// Which channel this template is for
  channel        NotificationChannel
  /// Email subject line or push notification title (supports variables like {{company_name}})
  subject        String?             @db.VarChar(500)
  /// Message body with variable placeholders (e.g., "Hi {{first_name}}, your trial ends on {{trial_end_date}}")
  body_template  String              @db.Text
  /// List of variable names used in this template (e.g., ["first_name", "trial_end_date"])
  variables      Json                @default("[]") @db.JsonB
  /// Whether this template is currently in use
  is_active      Boolean             @default(true)
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  @@index([channel])
  @@map("notification_templates")
}

/// Individual notification sent to a user via a specific channel
model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  /// Tenant this notification belongs to
  tenant_id     String              @db.Uuid
  /// The user who should receive this notification
  user_id       String              @db.Uuid
  /// Event type that triggered this notification (e.g., "invoice_created", "lead_assigned", "payment_failed")
  type          String              @db.VarChar(100)
  /// Delivery channel
  channel       NotificationChannel
  /// Urgency level (affects delivery order and visual treatment)
  priority      NotificationPriority @default(MEDIUM)
  /// Short title for the notification
  title         String              @db.VarChar(255)
  /// Full notification content
  body          String              @db.Text
  /// Additional context for deep linking (e.g., {"invoice_id": "uuid", "url": "/invoices/123"})
  data          Json?               @db.JsonB
  /// Current delivery status
  status        NotificationStatus  @default(PENDING)
  /// When the notification was actually sent/dispatched
  sent_at       DateTime?
  /// When the user read/opened the notification
  read_at       DateTime?
  /// Error details if delivery failed
  error_message String?             @db.Text
  created_at    DateTime            @default(now())

  // --- Relations ---
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, user_id])
  @@index([status])
  @@index([type])
  @@index([created_at])
  @@map("notifications")
}

// ==============================================================================
// AUDIT & COMPLIANCE ENGINE — Complete action history
// ==============================================================================
// Every create, update, delete, login, export operation is logged here.
// Stores before/after values for data change tracking.
// Supports DPDP Act 2023 compliance requirements.
// ==============================================================================

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  /// Tenant context for the action
  tenant_id     String   @db.Uuid
  /// User who performed the action (null for system-triggered actions)
  user_id       String?  @db.Uuid
  /// The operation performed (e.g., "create", "update", "delete", "login", "export", "approve")
  action        String   @db.VarChar(50)
  /// The entity type affected (e.g., "tenant", "user", "lead", "invoice", "employee")
  resource_type String   @db.VarChar(100)
  /// The specific record ID that was affected
  resource_id   String?  @db.Uuid
  /// Field values before the change (for update/delete operations)
  old_values    Json?    @db.JsonB
  /// Field values after the change (for create/update operations)
  new_values    Json?    @db.JsonB
  /// Client IP address for security tracking
  ip_address    String?  @db.VarChar(45)
  /// Browser/client user agent string
  user_agent    String?  @db.VarChar(500)
  /// Correlation ID for request tracing across services
  request_id    String?  @db.Uuid
  created_at    DateTime @default(now())

  // --- Relations ---
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([user_id])
  @@index([resource_type, resource_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

// ==============================================================================
// CENTRAL AI ORCHESTRATOR — Foundation tables for AI integration
// ==============================================================================
// Phase 1 establishes the infrastructure:
//   - Provider configurations with pricing
//   - Prompt template management with versioning
//   - Usage tracking for cost management and billing reconciliation
//
// Phase 6 will enhance with RAG pipeline, multi-agent, and decision engine.
// ==============================================================================

/// Configuration for each AI provider and model with pricing information
model AIProviderConfig {
  id                        String   @id @default(uuid()) @db.Uuid
  /// Provider name (e.g., "openai", "anthropic", "google", "local")
  provider_name             String   @db.VarChar(50)
  /// Specific model identifier (e.g., "gpt-4o", "gpt-4o-mini", "claude-3.5-sonnet")
  model_name                String   @db.VarChar(100)
  /// Custom API endpoint URL (for self-hosted or proxy setups)
  api_endpoint              String?  @db.VarChar(500)
  /// Cost per 1,000 input tokens in USD
  cost_per_1k_input_tokens  Decimal  @db.Decimal(10, 6)
  /// Cost per 1,000 output tokens in USD
  cost_per_1k_output_tokens Decimal  @db.Decimal(10, 6)
  /// Maximum tokens the model can handle per request
  max_tokens                Int      @default(4096)
  /// Whether this provider/model is currently available for use
  is_active                 Boolean  @default(true)
  /// Failover priority (lower number = higher priority, used when primary fails)
  priority                  Int      @default(0)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  // --- Relations ---
  usage_logs AIUsageLog[]

  @@unique([provider_name, model_name])
  @@map("ai_provider_configs")
}

/// Versioned prompt templates for consistent AI interactions across the platform
model AIPromptTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  /// Human-readable template name (e.g., "Lead Score Calculator", "Email Composer")
  template_name  String   @db.VarChar(100)
  /// Unique machine-readable code (e.g., "lead_score_calc", "email_compose")
  template_code  String   @unique @db.VarChar(100)
  /// System-level instructions for the AI model
  system_prompt  String   @db.Text
  /// User-facing prompt template with {{variable}} placeholders
  user_prompt    String   @db.Text
  /// List of variable names required by this template
  variables      Json     @default("[]") @db.JsonB
  /// Functional category (e.g., "email", "summary", "analysis", "scoring", "classification")
  category       String   @db.VarChar(50)
  /// Template version number (incremented on updates for audit trail)
  version        Int      @default(1)
  /// Whether this is the active version of the template
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([category])
  @@map("ai_prompt_templates")
}

/// Tracks every AI API call for cost management, billing, and analytics
model AIUsageLog {
  id            String   @id @default(uuid()) @db.Uuid
  /// Tenant that initiated the AI request (for billing attribution)
  tenant_id     String   @db.Uuid
  /// User who triggered the request (null for system-triggered calls)
  user_id       String?  @db.Uuid
  /// Which AI provider/model was used
  provider_id   String   @db.Uuid
  /// Type of AI request (e.g., "chat", "completion", "embedding", "sentiment", "summary")
  request_type  String   @db.VarChar(50)
  /// Number of input tokens consumed
  input_tokens  Int      @default(0)
  /// Number of output tokens generated
  output_tokens Int      @default(0)
  /// Calculated cost in USD for this request
  total_cost    Decimal  @db.Decimal(10, 6)
  /// Response time in milliseconds (for performance monitoring)
  latency_ms    Int?
  /// Request outcome (e.g., "success", "error", "timeout", "rate_limited")
  status        String   @db.VarChar(20)
  /// Error details if the request failed
  error_message String?  @db.Text
  /// Additional request context (e.g., {"prompt_template": "lead_score_calc", "module": "crm"})
  metadata      Json?    @db.JsonB
  created_at    DateTime @default(now())

  // --- Relations ---
  tenant   Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user     User?            @relation(fields: [user_id], references: [id], onDelete: SetNull)
  provider AIProviderConfig @relation(fields: [provider_id], references: [id], onDelete: Restrict)

  @@index([tenant_id])
  @@index([user_id])
  @@index([created_at])
  @@index([request_type])
  @@map("ai_usage_logs")
}

// ==============================================================================
// PHASE 2: SUBSCRIPTION & BILLING ENGINE
// ==============================================================================
// Manages tenant subscriptions, platform invoices, payment methods, and payments.
// This is the PLATFORM billing (Softmerce charging tenants), distinct from the
// Accounting module's sales invoices (tenants billing their own customers).
// ==============================================================================

/// Tracks each tenant's subscription lifecycle (upgrades, downgrades, cancellations)
model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  tenant_id             String             @db.Uuid
  plan_id               String             @db.Uuid
  /// Subscription lifecycle status
  status                SubscriptionStatus @default(TRIAL)
  /// How often the tenant is billed
  billing_cycle         BillingCycle       @default(MONTHLY)
  /// Start of the current billing period
  current_period_start  DateTime
  /// End of the current billing period
  current_period_end    DateTime
  /// Whether to cancel at the end of the current period (rather than immediately)
  cancel_at_period_end  Boolean            @default(false)
  /// When cancellation was requested (null if not cancelled)
  cancelled_at          DateTime?
  /// When the trial period ends (null if not a trial)
  trial_end             DateTime?
  /// Number of licensed seats/units
  quantity              Int                @default(1)
  /// Reference to an applied discount or coupon
  discount_id           String?            @db.Uuid
  /// Default payment method for auto-charging
  payment_method_id     String?            @db.Uuid
  /// When the next invoice should be generated
  next_invoice_at       DateTime?
  /// Additional subscription metadata (e.g., add-ons, custom terms)
  metadata              Json?              @db.JsonB
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  // --- Relations ---
  tenant         Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  discount       Discount?        @relation(fields: [discount_id], references: [id], onDelete: SetNull)
  payment_method PaymentMethod?   @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  invoices       PlatformInvoice[]

  @@index([tenant_id])
  @@index([status])
  @@index([next_invoice_at])
  @@map("subscriptions")
}

/// Discount codes and coupon campaigns
model Discount {
  id               String    @id @default(uuid()) @db.Uuid
  /// Coupon code entered by the customer (e.g., "LAUNCH50", "ANNUAL20OFF")
  coupon_code      String    @unique @db.VarChar(50)
  /// Human-readable description (e.g., "50% off first 3 months")
  description      String?   @db.Text
  /// Percentage discount (e.g., 20 for 20% off) — mutually exclusive with flat_amount
  discount_percent Decimal?  @db.Decimal(5, 2)
  /// Flat amount discount in INR — mutually exclusive with discount_percent
  flat_amount      Decimal?  @db.Decimal(10, 2)
  /// Maximum discount amount in INR (caps percentage discounts)
  max_discount     Decimal?  @db.Decimal(10, 2)
  /// When the coupon becomes valid
  valid_from       DateTime
  /// When the coupon expires (null for no expiry)
  valid_until      DateTime?
  /// Maximum total redemptions allowed (null for unlimited)
  max_redemptions  Int?
  /// Number of times this coupon has been used
  times_redeemed   Int       @default(0)
  /// Whether the coupon is currently active
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // --- Relations ---
  subscriptions Subscription[]

  @@index([coupon_code])
  @@index([is_active])
  @@map("discounts")
}

/// Saved payment methods for tenants (cards, UPI, bank accounts)
model PaymentMethod {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  /// Payment method type (e.g., "credit_card", "debit_card", "upi", "net_banking")
  method_type         String   @db.VarChar(50)
  /// Payment gateway provider identifier (e.g., "razorpay", "stripe")
  provider            String   @db.VarChar(50)
  /// Gateway-assigned identifier for this payment method
  provider_method_id  String?  @db.VarChar(255)
  /// Last 4 digits of card or masked identifier for display
  last_four           String?  @db.VarChar(4)
  /// Card brand (e.g., "visa", "mastercard") or bank name
  brand               String?  @db.VarChar(50)
  /// Card/method expiry month
  expiry_month        Int?
  /// Card/method expiry year
  expiry_year         Int?
  /// Whether this is the tenant's default payment method
  is_default          Boolean  @default(false)
  /// Additional gateway-specific metadata
  metadata            Json?    @db.JsonB
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // --- Relations ---
  tenant        Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  payments      PlatformPayment[]

  @@index([tenant_id])
  @@map("payment_methods")
}

/// Platform-generated invoices for tenant subscriptions
model PlatformInvoice {
  id                 String                @id @default(uuid()) @db.Uuid
  tenant_id          String                @db.Uuid
  subscription_id    String?               @db.Uuid
  /// Auto-generated sequential invoice number (e.g., "SOFT-INV-2026-00001")
  invoice_number     String                @unique @db.VarChar(50)
  /// Invoice lifecycle status
  status             PlatformInvoiceStatus @default(DRAFT)
  /// Billing period this invoice covers — start date
  period_start       DateTime
  /// Billing period this invoice covers — end date
  period_end         DateTime
  /// Subtotal before tax in INR
  subtotal           Decimal               @db.Decimal(12, 2)
  /// Tax amount (GST) in INR
  tax_amount         Decimal               @db.Decimal(12, 2)
  /// CGST amount (intra-state)
  cgst_amount        Decimal               @default(0) @db.Decimal(12, 2)
  /// SGST amount (intra-state)
  sgst_amount        Decimal               @default(0) @db.Decimal(12, 2)
  /// IGST amount (inter-state)
  igst_amount        Decimal               @default(0) @db.Decimal(12, 2)
  /// Discount amount applied
  discount_amount    Decimal               @default(0) @db.Decimal(12, 2)
  /// Total amount due (subtotal + tax - discount) in INR
  total_amount       Decimal               @db.Decimal(12, 2)
  /// Amount already paid against this invoice
  amount_paid        Decimal               @default(0) @db.Decimal(12, 2)
  /// Remaining balance (total_amount - amount_paid)
  amount_due         Decimal               @db.Decimal(12, 2)
  /// Currency code
  currency           String                @default("INR") @db.VarChar(3)
  /// When payment is due
  due_date           DateTime
  /// When the invoice was actually paid in full
  paid_at            DateTime?
  /// Additional invoice notes or terms
  notes              String?               @db.Text
  /// PDF download URL
  pdf_url            String?               @db.VarChar(500)
  /// IRN for GST e-invoicing compliance
  irn                String?               @db.VarChar(64)
  /// Additional metadata
  metadata           Json?                 @db.JsonB
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt

  // --- Relations ---
  tenant       Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  subscription Subscription?       @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  items        PlatformInvoiceItem[]
  payments     PlatformPayment[]

  @@index([tenant_id])
  @@index([status])
  @@index([due_date])
  @@index([invoice_number])
  @@map("platform_invoices")
}

/// Line items on a platform invoice
model PlatformInvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoice_id  String  @db.Uuid
  /// Description of the charge (e.g., "Professional Plan — Monthly", "AI Token Overage")
  description String  @db.VarChar(255)
  /// HSN/SAC code for GST
  hsn_sac     String? @db.VarChar(10)
  /// Number of units
  quantity    Int     @default(1)
  /// Price per unit in INR
  unit_price  Decimal @db.Decimal(12, 2)
  /// Tax rate percentage (e.g., 18 for 18% GST)
  tax_rate    Decimal @default(18) @db.Decimal(5, 2)
  /// Line total (quantity * unit_price)
  amount      Decimal @db.Decimal(12, 2)

  // --- Relations ---
  invoice PlatformInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("platform_invoice_items")
}

/// Payments received for platform invoices
model PlatformPayment {
  id                 String        @id @default(uuid()) @db.Uuid
  invoice_id         String        @db.Uuid
  payment_method_id  String?       @db.Uuid
  /// Amount paid in INR
  amount             Decimal       @db.Decimal(12, 2)
  /// Currency code
  currency           String        @default("INR") @db.VarChar(3)
  /// Payment lifecycle status
  status             PaymentStatus @default(PENDING)
  /// Payment mode used for this transaction
  payment_mode       PaymentMode   @default(OTHER)
  /// Payment gateway used (e.g., "razorpay", "stripe")
  gateway            String?       @db.VarChar(50)
  /// Transaction ID from the payment gateway
  gateway_payment_id String?       @db.VarChar(255)
  /// Gateway order ID
  gateway_order_id   String?       @db.VarChar(255)
  /// Error message if payment failed
  failure_reason     String?       @db.Text
  /// Additional payment metadata (e.g., UPI handle, card type)
  metadata           Json?         @db.JsonB
  /// When the payment was confirmed/completed
  paid_at            DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  // --- Relations ---
  invoice        PlatformInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  payment_method PaymentMethod?  @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)

  @@index([invoice_id])
  @@index([status])
  @@index([gateway_payment_id])
  @@map("platform_payments")
}

// ==============================================================================
// PHASE 2: CRM MODULE — Customer Relationship Management
// ==============================================================================
// Manages the full sales lifecycle:
//   Lead → Contact → Customer → Deal
// With pipeline management, activity tracking, and lead scoring.
// ==============================================================================

/// Sales pipeline definition (e.g., "Enterprise Sales", "SMB Pipeline")
model Pipeline {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  /// Pipeline display name
  name        String   @db.VarChar(100)
  /// Whether this is the default pipeline for new deals
  is_default  Boolean  @default(false)
  /// Whether this pipeline is currently active
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // --- Relations ---
  tenant Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@index([tenant_id])
  @@map("pipelines")
}

/// Stages within a sales pipeline (e.g., "Prospecting", "Proposal Sent", "Negotiation")
model PipelineStage {
  id             String   @id @default(uuid()) @db.Uuid
  pipeline_id    String   @db.Uuid
  /// Stage display name
  name           String   @db.VarChar(100)
  /// Display order (lower = earlier in pipeline)
  sort_order     Int      @default(0)
  /// Win probability percentage at this stage (for forecasting)
  win_probability Decimal @default(0) @db.Decimal(5, 2)
  /// CSS color code for visual representation
  color          String?  @db.VarChar(7)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // --- Relations ---
  pipeline Pipeline @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipeline_id])
  @@map("pipeline_stages")
}

/// Sales lead — potential customer who has shown interest
model Lead {
  id               String      @id @default(uuid()) @db.Uuid
  tenant_id        String      @db.Uuid
  /// Lead's first/given name
  first_name       String      @db.VarChar(100)
  /// Lead's last/family name
  last_name        String?     @db.VarChar(100)
  /// Primary email for communication
  email            String      @db.VarChar(255)
  /// Primary phone number
  phone            String?     @db.VarChar(20)
  /// Company/organization the lead works for
  company_name     String?     @db.VarChar(255)
  /// Lead's role/designation at their company
  job_title        String?     @db.VarChar(100)
  /// Marketing channel that brought this lead
  source           LeadSource  @default(OTHER)
  /// Current stage in the lead qualification funnel
  status           LeadStatus  @default(NEW)
  /// AI-calculated lead quality score (0-100, higher = more likely to convert)
  lead_score       Int         @default(0)
  /// Sales representative assigned to this lead
  owner_id         String      @db.Uuid
  /// Whether the lead has been converted to a customer
  is_converted     Boolean     @default(false)
  /// When the lead was converted
  converted_at     DateTime?
  /// Timestamp of the most recent interaction with this lead
  last_activity_at DateTime?
  /// Scheduled date/time for the next follow-up action
  next_follow_up   DateTime?
  /// Custom categorization tags (e.g., ["hot", "enterprise", "fintech"])
  tags             Json        @default("[]") @db.JsonB
  /// Tenant-defined custom fields for industry-specific data
  custom_fields    Json        @default("{}") @db.JsonB
  /// Soft delete
  is_deleted       Boolean     @default(false)
  deleted_at       DateTime?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  // --- Relations ---
  tenant     Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  owner      User           @relation("LeadOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  activities LeadActivity[]
  /// Contact created when this lead is converted
  contact_id String?        @db.Uuid
  contact    Contact?       @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([owner_id])
  @@index([status])
  @@index([source])
  @@index([lead_score])
  @@index([is_converted])
  @@index([is_deleted])
  @@index([next_follow_up])
  @@map("leads")
}

/// Activity log for lead interactions (calls, emails, meetings, notes)
model LeadActivity {
  id            String   @id @default(uuid()) @db.Uuid
  lead_id       String   @db.Uuid
  /// User who performed the activity
  performed_by  String   @db.Uuid
  /// Activity type (e.g., "call", "email", "meeting", "note", "sms", "whatsapp", "task")
  activity_type String   @db.VarChar(50)
  /// Brief title of the activity (e.g., "Introductory call", "Sent proposal")
  title         String   @db.VarChar(255)
  /// Detailed notes about the activity
  description   String?  @db.Text
  /// Outcome of the activity (e.g., "interested", "no_answer", "callback_requested")
  outcome       String?  @db.VarChar(100)
  /// When the activity took place (can be in the past for logging)
  activity_date DateTime @default(now())
  /// Duration in minutes (for calls, meetings)
  duration_mins Int?
  /// Additional activity data (e.g., {"call_recording_url": "...", "email_thread_id": "..."})
  metadata      Json?    @db.JsonB
  created_at    DateTime @default(now())

  // --- Relations ---
  lead      Lead @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  performer User @relation(fields: [performed_by], references: [id], onDelete: Restrict)

  @@index([lead_id])
  @@index([performed_by])
  @@index([activity_type])
  @@index([activity_date])
  @@map("lead_activities")
}

/// Contact — a person (often converted from a Lead) who can be linked to a Customer
model Contact {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  /// Associated customer/company (null for independent contacts)
  customer_id   String?  @db.Uuid
  /// Contact first name
  first_name    String   @db.VarChar(100)
  /// Contact last name
  last_name     String?  @db.VarChar(100)
  /// Primary email
  email         String   @db.VarChar(255)
  /// Primary phone
  phone         String?  @db.VarChar(20)
  /// Job title/designation
  job_title     String?  @db.VarChar(100)
  /// Department within their organization
  department    String?  @db.VarChar(100)
  /// Whether this is the primary contact for the customer
  is_primary    Boolean  @default(false)
  /// Custom tags
  tags          Json     @default("[]") @db.JsonB
  /// Custom fields
  custom_fields Json     @default("{}") @db.JsonB
  /// Soft delete
  is_deleted    Boolean  @default(false)
  deleted_at    DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // --- Relations ---
  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  leads    Lead[]

  @@index([tenant_id])
  @@index([customer_id])
  @@index([email])
  @@index([is_deleted])
  @@map("contacts")
}

/// Customer — a company/organization that buys from the tenant
model Customer {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  /// Auto-generated customer code (e.g., "CUST-0001")
  customer_code     String   @db.VarChar(50)
  /// Legal company name
  company_name      String   @db.VarChar(255)
  /// Trading/display name
  trade_name        String?  @db.VarChar(255)
  /// Primary contact email
  email             String   @db.VarChar(255)
  /// Primary phone number
  phone             String?  @db.VarChar(20)
  /// Website URL
  website           String?  @db.VarChar(500)
  /// GST Identification Number (for Indian GST compliance)
  gstin             String?  @db.VarChar(15)
  /// PAN number
  pan_number        String?  @db.VarChar(10)
  /// Billing address as structured JSON
  billing_address   Json?    @db.JsonB
  /// Shipping address as structured JSON (if different from billing)
  shipping_address  Json?    @db.JsonB
  /// Payment terms in days (e.g., 30 for Net 30)
  payment_terms     Int      @default(30)
  /// Credit limit in INR
  credit_limit      Decimal  @default(0) @db.Decimal(14, 2)
  /// Outstanding balance (auto-calculated, denormalized for performance)
  outstanding_amount Decimal @default(0) @db.Decimal(14, 2)
  /// Industry classification tags
  tags              Json     @default("[]") @db.JsonB
  /// Custom fields
  custom_fields     Json     @default("{}") @db.JsonB
  /// Whether this customer is currently active
  is_active         Boolean  @default(true)
  /// Soft delete
  is_deleted        Boolean  @default(false)
  deleted_at        DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // --- Relations ---
  tenant         Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  contacts       Contact[]
  deals          Deal[]
  sales_invoices SalesInvoice[]
  payment_receipts PaymentReceipt[]
  credit_notes   CreditNote[]
  // Phase 4
  sales_orders   SalesOrder[]

  @@unique([tenant_id, customer_code])
  @@index([tenant_id])
  @@index([company_name])
  @@index([gstin])
  @@index([is_active])
  @@index([is_deleted])
  @@map("customers")
}

/// Sales deal / opportunity in the pipeline
model Deal {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  /// Auto-generated deal reference (e.g., "DEAL-2026-0001")
  deal_number      String    @db.VarChar(50)
  /// Deal title / name (e.g., "Acme Corp — Enterprise License")
  title            String    @db.VarChar(255)
  /// Associated customer
  customer_id      String?   @db.Uuid
  /// Pipeline this deal belongs to
  pipeline_id      String    @db.Uuid
  /// Current stage in the pipeline
  stage_id         String    @db.Uuid
  /// Sales rep who owns this deal
  owner_id         String    @db.Uuid
  /// Expected revenue value in INR
  deal_value       Decimal   @default(0) @db.Decimal(14, 2)
  /// Currency code
  currency         String    @default("INR") @db.VarChar(3)
  /// AI/Manual-calculated win probability (0-100)
  win_probability  Decimal   @default(0) @db.Decimal(5, 2)
  /// Expected date to close the deal
  expected_close   DateTime?
  /// When the deal was actually closed
  actual_close     DateTime?
  /// Reason for losing the deal (if closed-lost)
  loss_reason      String?   @db.Text
  /// Source of the deal (referral, inbound, outbound, etc.)
  source           String?   @db.VarChar(100)
  /// Custom tags
  tags             Json      @default("[]") @db.JsonB
  /// Additional deal metadata
  custom_fields    Json      @default("{}") @db.JsonB
  /// Soft delete
  is_deleted       Boolean   @default(false)
  deleted_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // --- Relations ---
  tenant   Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer Customer?      @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  pipeline Pipeline       @relation(fields: [pipeline_id], references: [id], onDelete: Restrict)
  stage    PipelineStage  @relation(fields: [stage_id], references: [id], onDelete: Restrict)
  owner    User           @relation("DealOwner", fields: [owner_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, deal_number])
  @@index([tenant_id])
  @@index([customer_id])
  @@index([pipeline_id])
  @@index([stage_id])
  @@index([owner_id])
  @@index([expected_close])
  @@index([is_deleted])
  @@map("deals")
}

// ==============================================================================
// PHASE 2: ACCOUNTING MODULE
// ==============================================================================
// Double-entry bookkeeping with Indian GST compliance.
// Supports: Chart of Accounts, Journal Entries, Sales Invoices, Purchase Bills,
//           Payment Receipts, Payments Made, Credit/Debit Notes, Bank Accounts.
// ==============================================================================

/// Tax rate definitions (GST rates for India — CGST/SGST/IGST)
model TaxRate {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  /// Display name (e.g., "GST 18%", "GST 5%", "Exempt")
  name         String   @db.VarChar(100)
  /// Rate code for internal use (e.g., "gst_18", "gst_5", "exempt")
  rate_code    String   @db.VarChar(50)
  /// Tax percentage (e.g., 18.00 for 18% total GST)
  rate_percent Decimal  @db.Decimal(5, 2)
  /// GST type for Indian compliance
  gst_type     GstType  @default(NONE)
  /// HSN/SAC code this rate applies to
  hsn_sac      String?  @db.VarChar(10)
  /// Whether this tax rate is currently active
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // --- Relations ---
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, rate_code])
  @@index([tenant_id])
  @@map("tax_rates")
}

/// Chart of Accounts — hierarchical account structure for double-entry bookkeeping
model ChartOfAccount {
  id             String      @id @default(uuid()) @db.Uuid
  tenant_id      String      @db.Uuid
  /// Account code (e.g., "1000", "2100", "4000") — follows standard numbering
  account_code   String      @db.VarChar(20)
  /// Account display name (e.g., "Cash and Bank", "Accounts Receivable", "Sales Revenue")
  account_name   String      @db.VarChar(255)
  /// Account classification
  account_type   AccountType
  /// Whether the account normally has a debit or credit balance
  balance_type   BalanceType
  /// Parent account ID for hierarchical structure (null for top-level accounts)
  parent_id      String?     @db.Uuid
  /// Depth level in the hierarchy (0 for root, 1 for children, etc.)
  level          Int         @default(0)
  /// Description of the account's purpose
  description    String?     @db.Text
  /// Current balance (denormalized for quick access, updated by journal posts)
  current_balance Decimal    @default(0) @db.Decimal(14, 2)
  /// Whether this account is currently in use
  is_active      Boolean     @default(true)
  /// System accounts cannot be deleted (e.g., Accounts Receivable, Accounts Payable)
  is_system      Boolean     @default(false)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  // --- Relations ---
  tenant  Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent  ChartOfAccount?  @relation("AccountHierarchy", fields: [parent_id], references: [id], onDelete: Restrict)
  children ChartOfAccount[] @relation("AccountHierarchy")
  /// Debit side journal entry lines
  debit_lines   JournalEntryLine[] @relation("DebitAccount")
  /// Credit side journal entry lines
  credit_lines  JournalEntryLine[] @relation("CreditAccount")
  /// Bank accounts linked to this chart account
  bank_accounts BankAccount[]

  @@unique([tenant_id, account_code])
  @@index([tenant_id])
  @@index([account_type])
  @@index([parent_id])
  @@index([is_active])
  @@map("chart_of_accounts")
}

/// Journal Entry — header for a double-entry bookkeeping transaction
model JournalEntry {
  id              String        @id @default(uuid()) @db.Uuid
  tenant_id       String        @db.Uuid
  /// Auto-generated sequential entry number (e.g., "JE-2026-00001")
  entry_number    String        @db.VarChar(50)
  /// Date of the transaction
  entry_date      DateTime      @db.Date
  /// Description / narration of the transaction
  description     String        @db.Text
  /// Source document reference (e.g., "Invoice #INV-001", "Bill #BILL-002")
  reference       String?       @db.VarChar(255)
  /// Source document type for cross-referencing (e.g., "sales_invoice", "purchase_bill", "payment_receipt")
  source_type     String?       @db.VarChar(50)
  /// Source document ID for linking back to the originating transaction
  source_id       String?       @db.Uuid
  /// Entry approval status
  status          JournalStatus @default(DRAFT)
  /// User who created this entry
  created_by      String        @db.Uuid
  /// If this is a reversal, reference to the original entry
  reversed_entry_id String?     @db.Uuid
  /// Additional metadata
  metadata        Json?         @db.JsonB
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  // --- Relations ---
  tenant   Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  creator  User               @relation(fields: [created_by], references: [id], onDelete: Restrict)
  lines    JournalEntryLine[]

  @@unique([tenant_id, entry_number])
  @@index([tenant_id])
  @@index([entry_date])
  @@index([status])
  @@index([source_type, source_id])
  @@map("journal_entries")
}

/// Journal Entry Line — individual debit or credit leg of a journal entry
model JournalEntryLine {
  id              String   @id @default(uuid()) @db.Uuid
  journal_entry_id String  @db.Uuid
  /// Account being debited
  debit_account_id  String?  @db.Uuid
  /// Account being credited
  credit_account_id String?  @db.Uuid
  /// Amount for this line (always positive; direction determined by debit/credit account)
  amount          Decimal  @db.Decimal(14, 2)
  /// Line-level description/narration
  description     String?  @db.VarChar(500)
  created_at      DateTime @default(now())

  // --- Relations ---
  journal_entry  JournalEntry   @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
  debit_account  ChartOfAccount? @relation("DebitAccount", fields: [debit_account_id], references: [id], onDelete: Restrict)
  credit_account ChartOfAccount? @relation("CreditAccount", fields: [credit_account_id], references: [id], onDelete: Restrict)

  @@index([journal_entry_id])
  @@map("journal_entry_lines")
}

/// Sales Invoice — invoice issued by a tenant to their customers
model SalesInvoice {
  id                String        @id @default(uuid()) @db.Uuid
  tenant_id         String        @db.Uuid
  /// Customer being billed
  customer_id       String        @db.Uuid
  /// Auto-generated sequential invoice number (e.g., "INV-2026-00001")
  invoice_number    String        @db.VarChar(50)
  /// Invoice lifecycle status
  status            InvoiceStatus @default(DRAFT)
  /// Date the invoice was issued
  invoice_date      DateTime      @db.Date
  /// Payment due date
  due_date          DateTime      @db.Date
  /// Subtotal before tax
  subtotal          Decimal       @db.Decimal(14, 2)
  /// Total tax amount
  tax_amount        Decimal       @default(0) @db.Decimal(14, 2)
  /// CGST amount (intra-state supply)
  cgst_amount       Decimal       @default(0) @db.Decimal(14, 2)
  /// SGST amount (intra-state supply)
  sgst_amount       Decimal       @default(0) @db.Decimal(14, 2)
  /// IGST amount (inter-state supply)
  igst_amount       Decimal       @default(0) @db.Decimal(14, 2)
  /// Discount amount
  discount_amount   Decimal       @default(0) @db.Decimal(14, 2)
  /// Grand total (subtotal + tax - discount)
  total_amount      Decimal       @db.Decimal(14, 2)
  /// Amount already received
  amount_paid       Decimal       @default(0) @db.Decimal(14, 2)
  /// Outstanding balance (total_amount - amount_paid)
  amount_due        Decimal       @db.Decimal(14, 2)
  /// Currency code
  currency          String        @default("INR") @db.VarChar(3)
  /// Place of supply (state code) for GST
  place_of_supply   String?       @db.VarChar(2)
  /// Invoice terms and conditions
  terms             String?       @db.Text
  /// Internal notes (not shown on invoice)
  notes             String?       @db.Text
  /// Customer notes (shown on invoice)
  customer_notes    String?       @db.Text
  /// PDF document URL
  pdf_url           String?       @db.VarChar(500)
  /// IRN for e-invoicing
  irn               String?       @db.VarChar(64)
  /// Linked journal entry for bookkeeping
  journal_entry_id  String?       @db.Uuid
  /// Soft delete
  is_deleted        Boolean       @default(false)
  deleted_at        DateTime?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  // --- Relations ---
  tenant            Tenant                     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer          Customer                   @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  items             SalesInvoiceItem[]
  payment_allocations PaymentReceiptAllocation[]
  credit_notes      CreditNote[]

  @@unique([tenant_id, invoice_number])
  @@index([tenant_id])
  @@index([customer_id])
  @@index([status])
  @@index([invoice_date])
  @@index([due_date])
  @@index([is_deleted])
  @@map("sales_invoices")
}

/// Line item on a sales invoice
model SalesInvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoice_id     String  @db.Uuid
  /// Item description (e.g., "Web Development Services — March 2026")
  description    String  @db.VarChar(500)
  /// HSN/SAC code for GST classification
  hsn_sac        String? @db.VarChar(10)
  /// Quantity of items/units
  quantity       Decimal @default(1) @db.Decimal(10, 2)
  /// Unit of measurement (e.g., "hours", "units", "months")
  unit           String? @db.VarChar(20)
  /// Price per unit in INR
  unit_price     Decimal @db.Decimal(14, 2)
  /// Discount percentage on this line item
  discount_rate  Decimal @default(0) @db.Decimal(5, 2)
  /// Tax rate percentage
  tax_rate       Decimal @default(0) @db.Decimal(5, 2)
  /// Tax amount for this line
  tax_amount     Decimal @default(0) @db.Decimal(14, 2)
  /// Line total (quantity * unit_price - discount + tax)
  amount         Decimal @db.Decimal(14, 2)
  /// Sort order within the invoice
  sort_order     Int     @default(0)

  // --- Relations ---
  invoice SalesInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
  @@map("sales_invoice_items")
}

/// Purchase Bill — bill received from a vendor/supplier
model PurchaseBill {
  id                String     @id @default(uuid()) @db.Uuid
  tenant_id         String     @db.Uuid
  /// Vendor name (in Phase 2, stored as text; will become FK in later phases)
  vendor_name       String     @db.VarChar(255)
  /// Vendor GSTIN for GST compliance
  vendor_gstin      String?    @db.VarChar(15)
  /// Auto-generated bill tracking number (e.g., "BILL-2026-00001")
  bill_number       String     @db.VarChar(50)
  /// Vendor's own invoice/bill reference number
  vendor_bill_number String?   @db.VarChar(100)
  /// Bill lifecycle status
  status            BillStatus @default(DRAFT)
  /// Date the bill was received/issued
  bill_date         DateTime   @db.Date
  /// Payment due date
  due_date          DateTime   @db.Date
  /// Subtotal before tax
  subtotal          Decimal    @db.Decimal(14, 2)
  /// Total tax amount
  tax_amount        Decimal    @default(0) @db.Decimal(14, 2)
  /// CGST amount
  cgst_amount       Decimal    @default(0) @db.Decimal(14, 2)
  /// SGST amount
  sgst_amount       Decimal    @default(0) @db.Decimal(14, 2)
  /// IGST amount
  igst_amount       Decimal    @default(0) @db.Decimal(14, 2)
  /// TDS amount deducted
  tds_amount        Decimal    @default(0) @db.Decimal(14, 2)
  /// Grand total
  total_amount      Decimal    @db.Decimal(14, 2)
  /// Amount already paid
  amount_paid       Decimal    @default(0) @db.Decimal(14, 2)
  /// Outstanding balance
  amount_due        Decimal    @db.Decimal(14, 2)
  /// Currency code
  currency          String     @default("INR") @db.VarChar(3)
  /// Place of supply (state code)
  place_of_supply   String?    @db.VarChar(2)
  /// Internal notes
  notes             String?    @db.Text
  /// Linked journal entry
  journal_entry_id  String?    @db.Uuid
  /// Soft delete
  is_deleted        Boolean    @default(false)
  deleted_at        DateTime?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  // --- Relations ---
  tenant             Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  items              PurchaseBillItem[]
  payment_allocations PaymentMadeAllocation[]
  debit_notes        DebitNote[]

  @@unique([tenant_id, bill_number])
  @@index([tenant_id])
  @@index([status])
  @@index([bill_date])
  @@index([due_date])
  @@index([is_deleted])
  @@map("purchase_bills")
}

/// Line item on a purchase bill
model PurchaseBillItem {
  id            String  @id @default(uuid()) @db.Uuid
  bill_id       String  @db.Uuid
  /// Item description
  description   String  @db.VarChar(500)
  /// HSN/SAC code
  hsn_sac       String? @db.VarChar(10)
  /// Quantity
  quantity      Decimal @default(1) @db.Decimal(10, 2)
  /// Unit of measurement
  unit          String? @db.VarChar(20)
  /// Unit price
  unit_price    Decimal @db.Decimal(14, 2)
  /// Tax rate percentage
  tax_rate      Decimal @default(0) @db.Decimal(5, 2)
  /// Tax amount for this line
  tax_amount    Decimal @default(0) @db.Decimal(14, 2)
  /// Line total
  amount        Decimal @db.Decimal(14, 2)
  /// Sort order
  sort_order    Int     @default(0)

  // --- Relations ---
  bill PurchaseBill @relation(fields: [bill_id], references: [id], onDelete: Cascade)

  @@index([bill_id])
  @@map("purchase_bill_items")
}

/// Payment received from a customer — can be allocated to one or more invoices
model PaymentReceipt {
  id                 String        @id @default(uuid()) @db.Uuid
  tenant_id          String        @db.Uuid
  customer_id        String        @db.Uuid
  /// Auto-generated receipt number (e.g., "REC-2026-00001")
  receipt_number     String        @db.VarChar(50)
  /// Total payment amount received in INR
  amount             Decimal       @db.Decimal(14, 2)
  /// Currency code
  currency           String        @default("INR") @db.VarChar(3)
  /// Payment lifecycle status
  status             PaymentStatus @default(PENDING)
  /// How the payment was made
  payment_mode       PaymentMode   @default(BANK_TRANSFER)
  /// Date the payment was received
  payment_date       DateTime      @db.Date
  /// Bank/transaction reference number
  reference_number   String?       @db.VarChar(255)
  /// Internal notes
  notes              String?       @db.Text
  /// Bank account where the payment was deposited
  bank_account_id    String?       @db.Uuid
  /// Linked journal entry
  journal_entry_id   String?       @db.Uuid
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  // --- Relations ---
  tenant       Tenant                     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer     Customer                   @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  bank_account BankAccount?               @relation(fields: [bank_account_id], references: [id], onDelete: SetNull)
  allocations  PaymentReceiptAllocation[]

  @@unique([tenant_id, receipt_number])
  @@index([tenant_id])
  @@index([customer_id])
  @@index([status])
  @@index([payment_date])
  @@map("payment_receipts")
}

/// Allocation of a payment receipt to specific invoices
model PaymentReceiptAllocation {
  id             String  @id @default(uuid()) @db.Uuid
  receipt_id     String  @db.Uuid
  invoice_id     String  @db.Uuid
  /// Amount allocated to this invoice
  amount         Decimal @db.Decimal(14, 2)
  created_at     DateTime @default(now())

  // --- Relations ---
  receipt PaymentReceipt @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  invoice SalesInvoice   @relation(fields: [invoice_id], references: [id], onDelete: Restrict)

  @@unique([receipt_id, invoice_id])
  @@map("payment_receipt_allocations")
}

/// Payment made to a vendor — can be allocated to one or more bills
model PaymentMade {
  id                 String        @id @default(uuid()) @db.Uuid
  tenant_id          String        @db.Uuid
  /// Vendor name (matches PurchaseBill vendor_name)
  vendor_name        String        @db.VarChar(255)
  /// Auto-generated payment number (e.g., "PAY-2026-00001")
  payment_number     String        @db.VarChar(50)
  /// Total payment amount in INR
  amount             Decimal       @db.Decimal(14, 2)
  /// Currency code
  currency           String        @default("INR") @db.VarChar(3)
  /// Payment lifecycle status
  status             PaymentStatus @default(PENDING)
  /// How the payment was made
  payment_mode       PaymentMode   @default(BANK_TRANSFER)
  /// Date the payment was made
  payment_date       DateTime      @db.Date
  /// Bank/transaction reference number
  reference_number   String?       @db.VarChar(255)
  /// TDS amount deducted from this payment
  tds_amount         Decimal       @default(0) @db.Decimal(14, 2)
  /// Internal notes
  notes              String?       @db.Text
  /// Bank account from which the payment was made
  bank_account_id    String?       @db.Uuid
  /// Linked journal entry
  journal_entry_id   String?       @db.Uuid
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  // --- Relations ---
  tenant       Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  bank_account BankAccount?            @relation(fields: [bank_account_id], references: [id], onDelete: SetNull)
  allocations  PaymentMadeAllocation[]

  @@unique([tenant_id, payment_number])
  @@index([tenant_id])
  @@index([status])
  @@index([payment_date])
  @@map("payments_made")
}

/// Allocation of a payment to specific purchase bills
model PaymentMadeAllocation {
  id         String  @id @default(uuid()) @db.Uuid
  payment_id String  @db.Uuid
  bill_id    String  @db.Uuid
  /// Amount allocated to this bill
  amount     Decimal @db.Decimal(14, 2)
  created_at DateTime @default(now())

  // --- Relations ---
  payment PaymentMade  @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  bill    PurchaseBill @relation(fields: [bill_id], references: [id], onDelete: Restrict)

  @@unique([payment_id, bill_id])
  @@map("payment_made_allocations")
}

/// Credit Note — issued to a customer for sales returns/adjustments
model CreditNote {
  id              String     @id @default(uuid()) @db.Uuid
  tenant_id       String     @db.Uuid
  customer_id     String     @db.Uuid
  /// Reference to the original invoice being credited
  invoice_id      String?    @db.Uuid
  /// Auto-generated credit note number (e.g., "CN-2026-00001")
  cn_number       String     @db.VarChar(50)
  /// Credit note lifecycle status
  status          NoteStatus @default(DRAFT)
  /// Date the credit note was issued
  cn_date         DateTime   @db.Date
  /// Reason for the credit note
  reason          String     @db.Text
  /// Subtotal
  subtotal        Decimal    @db.Decimal(14, 2)
  /// Tax amount
  tax_amount      Decimal    @default(0) @db.Decimal(14, 2)
  /// Total credit note amount
  total_amount    Decimal    @db.Decimal(14, 2)
  /// Currency code
  currency        String     @default("INR") @db.VarChar(3)
  /// Linked journal entry
  journal_entry_id String?   @db.Uuid
  /// Soft delete
  is_deleted      Boolean    @default(false)
  deleted_at      DateTime?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  // --- Relations ---
  tenant   Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  invoice  SalesInvoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  items    CreditNoteItem[]

  @@unique([tenant_id, cn_number])
  @@index([tenant_id])
  @@index([customer_id])
  @@index([invoice_id])
  @@index([status])
  @@index([is_deleted])
  @@map("credit_notes")
}

/// Line item on a credit note
model CreditNoteItem {
  id            String  @id @default(uuid()) @db.Uuid
  credit_note_id String @db.Uuid
  /// Item description
  description   String  @db.VarChar(500)
  /// HSN/SAC code
  hsn_sac       String? @db.VarChar(10)
  /// Quantity
  quantity      Decimal @default(1) @db.Decimal(10, 2)
  /// Unit price
  unit_price    Decimal @db.Decimal(14, 2)
  /// Tax rate
  tax_rate      Decimal @default(0) @db.Decimal(5, 2)
  /// Tax amount
  tax_amount    Decimal @default(0) @db.Decimal(14, 2)
  /// Line total
  amount        Decimal @db.Decimal(14, 2)
  sort_order    Int     @default(0)

  // --- Relations ---
  credit_note CreditNote @relation(fields: [credit_note_id], references: [id], onDelete: Cascade)

  @@index([credit_note_id])
  @@map("credit_note_items")
}

/// Debit Note — issued to a vendor for purchase returns/adjustments
model DebitNote {
  id               String     @id @default(uuid()) @db.Uuid
  tenant_id        String     @db.Uuid
  /// Reference to the original purchase bill
  bill_id          String?    @db.Uuid
  /// Auto-generated debit note number (e.g., "DN-2026-00001")
  dn_number        String     @db.VarChar(50)
  /// Vendor name
  vendor_name      String     @db.VarChar(255)
  /// Debit note status
  status           NoteStatus @default(DRAFT)
  /// Date the debit note was issued
  dn_date          DateTime   @db.Date
  /// Reason for the debit note
  reason           String     @db.Text
  /// Subtotal
  subtotal         Decimal    @db.Decimal(14, 2)
  /// Tax amount
  tax_amount       Decimal    @default(0) @db.Decimal(14, 2)
  /// Total debit note amount
  total_amount     Decimal    @db.Decimal(14, 2)
  /// Currency code
  currency         String     @default("INR") @db.VarChar(3)
  /// Linked journal entry
  journal_entry_id String?    @db.Uuid
  /// Soft delete
  is_deleted       Boolean    @default(false)
  deleted_at       DateTime?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  // --- Relations ---
  tenant Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  bill   PurchaseBill? @relation(fields: [bill_id], references: [id], onDelete: SetNull)
  items  DebitNoteItem[]

  @@unique([tenant_id, dn_number])
  @@index([tenant_id])
  @@index([bill_id])
  @@index([status])
  @@index([is_deleted])
  @@map("debit_notes")
}

/// Line item on a debit note
model DebitNoteItem {
  id            String  @id @default(uuid()) @db.Uuid
  debit_note_id String  @db.Uuid
  /// Item description
  description   String  @db.VarChar(500)
  /// HSN/SAC code
  hsn_sac       String? @db.VarChar(10)
  /// Quantity
  quantity      Decimal @default(1) @db.Decimal(10, 2)
  /// Unit price
  unit_price    Decimal @db.Decimal(14, 2)
  /// Tax rate
  tax_rate      Decimal @default(0) @db.Decimal(5, 2)
  /// Tax amount
  tax_amount    Decimal @default(0) @db.Decimal(14, 2)
  /// Line total
  amount        Decimal @db.Decimal(14, 2)
  sort_order    Int     @default(0)

  // --- Relations ---
  debit_note DebitNote @relation(fields: [debit_note_id], references: [id], onDelete: Cascade)

  @@index([debit_note_id])
  @@map("debit_note_items")
}

/// Bank Account — tracks the tenant's bank accounts for reconciliation
model BankAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  /// Display name (e.g., "HDFC Current Account", "SBI Savings")
  account_name        String   @db.VarChar(255)
  /// Bank name (e.g., "HDFC Bank", "State Bank of India")
  bank_name           String   @db.VarChar(255)
  /// Account number (partially masked in UI)
  account_number      String   @db.VarChar(50)
  /// IFSC code for Indian banks
  ifsc_code           String?  @db.VarChar(11)
  /// SWIFT code for international transfers
  swift_code          String?  @db.VarChar(11)
  /// Account type (e.g., "current", "savings", "overdraft")
  account_type        String   @db.VarChar(50)
  /// Current bank balance in INR (updated on reconciliation)
  current_balance     Decimal  @default(0) @db.Decimal(14, 2)
  /// Currency code
  currency            String   @default("INR") @db.VarChar(3)
  /// Linked chart of accounts entry
  chart_account_id    String?  @db.Uuid
  /// Date of last successful reconciliation
  last_reconciled_at  DateTime?
  /// Whether this account is currently active
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // --- Relations ---
  tenant          Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  chart_account   ChartOfAccount? @relation(fields: [chart_account_id], references: [id], onDelete: SetNull)
  transactions    BankTransaction[]
  payment_receipts PaymentReceipt[]
  payments_made   PaymentMade[]

  @@index([tenant_id])
  @@index([is_active])
  @@map("bank_accounts")
}

/// Individual bank transaction (debit/credit movement)
model BankTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  bank_account_id   String   @db.Uuid
  /// Transaction date
  transaction_date  DateTime @db.Date
  /// Transaction description from bank statement
  description       String   @db.VarChar(500)
  /// Transaction amount (positive for credit, negative for debit)
  amount            Decimal  @db.Decimal(14, 2)
  /// Running balance after this transaction
  balance           Decimal? @db.Decimal(14, 2)
  /// Transaction type (e.g., "deposit", "withdrawal", "transfer", "charge", "interest")
  transaction_type  String   @db.VarChar(50)
  /// Bank reference / UTR number
  reference         String?  @db.VarChar(255)
  /// Whether this transaction has been matched to an accounting entry
  is_reconciled     Boolean  @default(false)
  /// The matching document (e.g., invoice ID, receipt ID) when reconciled
  matched_reference String?  @db.VarChar(255)
  /// Additional metadata
  metadata          Json?    @db.JsonB
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // --- Relations ---
  bank_account BankAccount @relation(fields: [bank_account_id], references: [id], onDelete: Cascade)

  @@index([bank_account_id])
  @@index([transaction_date])
  @@index([is_reconciled])
  @@map("bank_transactions")
}

// ==============================================================================
// PHASE 3: HRMS MODULE — Human Resource Management System
// ==============================================================================
// Manages the full employee lifecycle:
//   Department → Designation → Employee → Attendance / Leave / Documents
// With hierarchical departments, holiday calendar, and comprehensive profiles.
// ==============================================================================

/// Organizational department with hierarchical support
model Department {
  id            String       @id @default(uuid()) @db.Uuid
  tenant_id     String       @db.Uuid
  /// Department code (e.g., "ENG", "HR", "FIN", "MKT")
  dept_code     String       @db.VarChar(20)
  /// Department name
  name          String       @db.VarChar(255)
  /// Short description of the department's function
  description   String?      @db.Text
  /// Parent department for hierarchical structures (null for top-level)
  parent_id     String?      @db.Uuid
  /// Head of department — Employee ID
  head_id       String?      @db.Uuid
  /// Whether the department is active
  is_active     Boolean      @default(true)
  /// Soft delete
  is_deleted    Boolean      @default(false)
  deleted_at    DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  // --- Relations ---
  tenant    Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent    Department?  @relation("DeptHierarchy", fields: [parent_id], references: [id], onDelete: Restrict)
  children  Department[] @relation("DeptHierarchy")
  head      Employee?    @relation("DeptHead", fields: [head_id], references: [id], onDelete: SetNull)
  employees Employee[]   @relation("EmployeeDept")

  @@unique([tenant_id, dept_code])
  @@index([tenant_id])
  @@index([parent_id])
  @@index([is_active])
  @@index([is_deleted])
  @@map("departments")
}

/// Job title / designation within the organization
model Designation {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  /// Designation code (e.g., "SE", "SSE", "PM", "VP")
  code        String   @db.VarChar(20)
  /// Display name (e.g., "Software Engineer", "Product Manager")
  title       String   @db.VarChar(255)
  /// Description of the role
  description String?  @db.Text
  /// Grade/band level for compensation grouping (e.g., "L1", "L2", "L3")
  grade       String?  @db.VarChar(20)
  /// Display order for listing
  sort_order  Int      @default(0)
  /// Whether this designation is currently in use
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // --- Relations ---
  tenant    Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([is_active])
  @@map("designations")
}

/// Employee — detailed profile linked to a User account
model Employee {
  id                    String         @id @default(uuid()) @db.Uuid
  tenant_id             String         @db.Uuid
  /// Auto-generated employee code (e.g., "EMP-0001")
  employee_code         String         @db.VarChar(50)
  /// Link to the User account for login/auth (optional — some employees may not have system access)
  user_id               String?        @unique @db.Uuid
  /// Department the employee belongs to
  department_id         String?        @db.Uuid
  /// Current designation/job title
  designation_id        String?        @db.Uuid
  /// Reports-to manager — Employee ID for organizational hierarchy
  reporting_manager_id  String?        @db.Uuid
  /// Employee's first name
  first_name            String         @db.VarChar(100)
  /// Employee's last name
  last_name             String         @db.VarChar(100)
  /// Primary email
  email                 String         @db.VarChar(255)
  /// Personal phone number
  phone                 String?        @db.VarChar(20)
  /// Emergency contact phone
  emergency_phone       String?        @db.VarChar(20)
  /// Emergency contact name
  emergency_contact_name String?       @db.VarChar(100)
  /// Date of birth
  date_of_birth         DateTime?      @db.Date
  /// Gender
  gender                Gender?
  /// Marital status
  marital_status        MaritalStatus?
  /// Blood group
  blood_group           String?        @db.VarChar(5)
  /// Nationality
  nationality           String?        @db.VarChar(50)
  /// PAN number (for Indian tax compliance)
  pan_number            String?        @db.VarChar(10)
  /// Aadhaar number (Indian unique ID)
  aadhaar_number        String?        @db.VarChar(12)
  /// UAN — Universal Account Number (for PF)
  uan_number            String?        @db.VarChar(12)
  /// ESI number
  esi_number            String?        @db.VarChar(17)
  /// Bank account number for salary credit
  bank_account_number   String?        @db.VarChar(30)
  /// Bank name
  bank_name             String?        @db.VarChar(100)
  /// IFSC code
  bank_ifsc             String?        @db.VarChar(11)
  /// Current address as structured JSON
  current_address       Json?          @db.JsonB
  /// Permanent address as structured JSON
  permanent_address     Json?          @db.JsonB
  /// Employment type
  employment_type       EmploymentType @default(FULL_TIME)
  /// Employment lifecycle status
  status                EmployeeStatus @default(ACTIVE)
  /// Date the employee joined
  date_of_joining       DateTime       @db.Date
  /// Confirmation date (end of probation)
  date_of_confirmation  DateTime?      @db.Date
  /// Last working day (if separated)
  date_of_exit          DateTime?      @db.Date
  /// Reason for separation
  exit_reason           String?        @db.Text
  /// Notice period in days
  notice_period_days    Int            @default(30)
  /// Work location / office
  work_location         String?        @db.VarChar(255)
  /// Work shift (e.g., "General", "Morning", "Night")
  shift                 String?        @db.VarChar(50)
  /// Profile photo URL
  photo_url             String?        @db.VarChar(500)
  /// Custom fields for tenant-specific data
  custom_fields         Json           @default("{}") @db.JsonB
  /// Additional metadata
  metadata              Json?          @db.JsonB
  /// Soft delete
  is_deleted            Boolean        @default(false)
  deleted_at            DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  // --- Relations ---
  tenant              Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user                User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  department          Department?       @relation("EmployeeDept", fields: [department_id], references: [id], onDelete: SetNull)
  designation         Designation?      @relation(fields: [designation_id], references: [id], onDelete: SetNull)
  reporting_manager   Employee?         @relation("ReportingHierarchy", fields: [reporting_manager_id], references: [id], onDelete: SetNull)
  direct_reports      Employee[]        @relation("ReportingHierarchy")
  departments_headed  Department[]      @relation("DeptHead")
  documents           EmployeeDocument[]
  attendance_records  Attendance[]
  leave_balances      LeaveBalance[]
  leave_requests      LeaveRequest[]    @relation("LeaveRequester")
  leave_approvals     LeaveRequest[]    @relation("LeaveApprover")
  employee_salary     EmployeeSalary?
  payslips            Payslip[]

  @@unique([tenant_id, employee_code])
  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@index([user_id])
  @@index([department_id])
  @@index([designation_id])
  @@index([reporting_manager_id])
  @@index([status])
  @@index([employment_type])
  @@index([date_of_joining])
  @@index([is_deleted])
  @@map("employees")
}

/// Employee document / file record
model EmployeeDocument {
  id            String           @id @default(uuid()) @db.Uuid
  employee_id   String           @db.Uuid
  /// Document category
  category      DocumentCategory
  /// Document title (e.g., "Aadhaar Card", "B.Tech Degree")
  title         String           @db.VarChar(255)
  /// Original filename
  file_name     String           @db.VarChar(255)
  /// File storage URL (S3/CDN)
  file_url      String           @db.VarChar(500)
  /// File MIME type
  mime_type     String?          @db.VarChar(100)
  /// File size in bytes
  file_size     Int?
  /// Expiry date (for ID proofs, certifications, etc.)
  expiry_date   DateTime?        @db.Date
  /// Whether the document has been verified by HR
  is_verified   Boolean          @default(false)
  /// Additional notes
  notes         String?          @db.Text
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  // --- Relations ---
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@index([category])
  @@map("employee_documents")
}

/// Daily attendance record for an employee
model Attendance {
  id              String           @id @default(uuid()) @db.Uuid
  tenant_id       String           @db.Uuid
  employee_id     String           @db.Uuid
  /// Date of attendance
  attendance_date DateTime         @db.Date
  /// Attendance status
  status          AttendanceStatus @default(PRESENT)
  /// Clock-in time
  check_in        DateTime?
  /// Clock-out time
  check_out       DateTime?
  /// Total hours worked (calculated from check_in/check_out)
  hours_worked    Decimal?         @db.Decimal(5, 2)
  /// Overtime hours
  overtime_hours  Decimal?         @db.Decimal(5, 2)
  /// Late arrival in minutes
  late_minutes    Int?
  /// Early departure in minutes
  early_leave_minutes Int?
  /// Check-in location coordinates (for geo-fenced attendance)
  check_in_location   Json?        @db.JsonB
  /// Check-out location coordinates
  check_out_location  Json?        @db.JsonB
  /// Employee's IP address at check-in
  ip_address      String?          @db.VarChar(45)
  /// Device info for biometric/mobile check-in
  device_info     String?          @db.VarChar(255)
  /// Internal notes (e.g., "Approved late arrival — doctor visit")
  notes           String?          @db.Text
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  // --- Relations ---
  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, attendance_date])
  @@index([tenant_id])
  @@index([employee_id])
  @@index([attendance_date])
  @@index([status])
  @@map("attendance")
}

/// Leave type definition (e.g., Casual Leave, Sick Leave, Earned Leave)
model LeaveType {
  id                 String   @id @default(uuid()) @db.Uuid
  tenant_id          String   @db.Uuid
  /// Leave type code (e.g., "CL", "SL", "EL", "ML", "PL")
  code               String   @db.VarChar(10)
  /// Display name (e.g., "Casual Leave", "Sick Leave")
  name               String   @db.VarChar(100)
  /// Description
  description        String?  @db.Text
  /// Annual allocation — number of days per year
  annual_allocation  Decimal  @db.Decimal(5, 1)
  /// Maximum days that can be carried forward to next year
  max_carry_forward  Decimal  @default(0) @db.Decimal(5, 1)
  /// Maximum consecutive days allowed in a single request
  max_consecutive_days Int?
  /// Whether this leave is paid
  is_paid            Boolean  @default(true)
  /// Whether medical certificate is required after N days
  requires_doc_after_days Int?
  /// Whether half-day leave is allowed
  allow_half_day     Boolean  @default(true)
  /// Whether this leave is applicable to all employees or specific criteria
  applicable_gender  Gender?
  /// Whether this leave type is currently active
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  // --- Relations ---
  tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  leave_balances LeaveBalance[]
  leave_requests LeaveRequest[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([is_active])
  @@map("leave_types")
}

/// Annual leave balance per employee per leave type
model LeaveBalance {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  employee_id     String   @db.Uuid
  leave_type_id   String   @db.Uuid
  /// Financial year (e.g., "2025-2026")
  fiscal_year     String   @db.VarChar(10)
  /// Total allocated days for this period
  allocated       Decimal  @db.Decimal(5, 1)
  /// Days carried forward from previous period
  carried_forward Decimal  @default(0) @db.Decimal(5, 1)
  /// Days used so far
  used            Decimal  @default(0) @db.Decimal(5, 1)
  /// Days with pending requests
  pending         Decimal  @default(0) @db.Decimal(5, 1)
  /// Available balance (allocated + carried_forward - used - pending)
  available       Decimal  @db.Decimal(5, 1)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // --- Relations ---
  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leave_type LeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, leave_type_id, fiscal_year])
  @@index([tenant_id])
  @@index([employee_id])
  @@index([leave_type_id])
  @@index([fiscal_year])
  @@map("leave_balances")
}

/// Leave application / request submitted by an employee
model LeaveRequest {
  id             String      @id @default(uuid()) @db.Uuid
  tenant_id      String      @db.Uuid
  employee_id    String      @db.Uuid
  leave_type_id  String      @db.Uuid
  /// Leave start date
  start_date     DateTime    @db.Date
  /// Leave end date (same as start_date for single-day leave)
  end_date       DateTime    @db.Date
  /// Number of days requested (accounts for half-days)
  days_requested Decimal     @db.Decimal(5, 1)
  /// Whether this is a half-day request
  is_half_day    Boolean     @default(false)
  /// For half-day: "first_half" or "second_half"
  half_day_type  String?     @db.VarChar(20)
  /// Reason for leave
  reason         String      @db.Text
  /// Supporting document URL (medical certificate, etc.)
  document_url   String?     @db.VarChar(500)
  /// Request lifecycle status
  status         LeaveStatus @default(PENDING)
  /// Who approved/rejected the request
  approver_id    String?     @db.Uuid
  /// Manager's comments when approving/rejecting
  approver_notes String?     @db.Text
  /// When the request was approved/rejected
  approved_at    DateTime?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  // --- Relations ---
  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee   Employee  @relation("LeaveRequester", fields: [employee_id], references: [id], onDelete: Cascade)
  leave_type LeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Restrict)
  approver   Employee? @relation("LeaveApprover", fields: [approver_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([employee_id])
  @@index([leave_type_id])
  @@index([status])
  @@index([start_date, end_date])
  @@map("leave_requests")
}

/// Company / public holiday calendar
model Holiday {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  /// Holiday name (e.g., "Republic Day", "Diwali", "Christmas")
  name          String   @db.VarChar(255)
  /// Holiday date
  date          DateTime @db.Date
  /// Calendar year for grouping
  year          Int
  /// Whether this is a mandatory/gazetted holiday
  is_mandatory  Boolean  @default(true)
  /// Whether it's a restricted/optional holiday
  is_optional   Boolean  @default(false)
  /// Applicable to all or specific departments (null = all)
  applicable_to Json?    @db.JsonB
  /// Description or occasion
  description   String?  @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // --- Relations ---
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, date])
  @@index([tenant_id])
  @@index([date])
  @@index([year])
  @@map("holidays")
}

// ==============================================================================
// PHASE 3: PAYROLL MODULE
// ==============================================================================
// Manages salary structure, monthly payroll processing, and payslip generation.
// Supports Indian statutory deductions: PF, ESI, Professional Tax, TDS.
// ==============================================================================

/// Salary component definition (e.g., Basic Salary, HRA, DA, PF, ESI, TDS)
model SalaryComponent {
  id                String            @id @default(uuid()) @db.Uuid
  tenant_id         String            @db.Uuid
  /// Component code (e.g., "BASIC", "HRA", "DA", "PF_EMPLOYEE", "ESI_EMPLOYEE")
  code              String            @db.VarChar(30)
  /// Display name (e.g., "Basic Salary", "House Rent Allowance")
  name              String            @db.VarChar(255)
  /// Short description
  description       String?           @db.Text
  /// Whether this is an earning or deduction
  component_type    ComponentType
  /// How the amount is calculated
  calculation_method CalculationMethod @default(FIXED)
  /// Percentage value (when calculation_method is PERCENTAGE_*)
  percentage_value  Decimal?          @db.Decimal(5, 2)
  /// Custom formula (when calculation_method is FORMULA)
  formula           String?           @db.Text
  /// Whether this component is taxable
  is_taxable        Boolean           @default(true)
  /// Whether this component is part of CTC
  is_part_of_ctc    Boolean           @default(true)
  /// Whether this is a statutory component (PF, ESI, PT, TDS)
  is_statutory      Boolean           @default(false)
  /// Statutory type code (e.g., "PF", "ESI", "PT", "TDS")
  statutory_code    String?           @db.VarChar(20)
  /// Display order within payslip
  sort_order        Int               @default(0)
  /// Whether this component is active
  is_active         Boolean           @default(true)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  // --- Relations ---
  tenant               Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  salary_structure_lines SalaryStructureLine[]
  payslip_lines        PayslipLine[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([component_type])
  @@index([is_active])
  @@map("salary_components")
}

/// Salary structure template — reusable pay package template
model SalaryStructure {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  /// Structure code (e.g., "STD-L1", "MGMT-L3")
  code         String   @db.VarChar(30)
  /// Display name (e.g., "Standard L1 Package", "Management L3")
  name         String   @db.VarChar(255)
  /// Description
  description  String?  @db.Text
  /// Base CTC (Cost to Company) for this structure
  base_ctc     Decimal? @db.Decimal(14, 2)
  /// Whether this structure is active
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // --- Relations ---
  tenant            Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  lines             SalaryStructureLine[]
  employee_salaries EmployeeSalary[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([is_active])
  @@map("salary_structures")
}

/// Line item in a salary structure — maps a component with its default amount/percentage
model SalaryStructureLine {
  id                  String  @id @default(uuid()) @db.Uuid
  salary_structure_id String  @db.Uuid
  salary_component_id String  @db.Uuid
  /// Default amount for this component (can be overridden per employee)
  default_amount      Decimal @default(0) @db.Decimal(14, 2)
  /// Percentage override (when component uses percentage calculation)
  percentage_override Decimal? @db.Decimal(5, 2)
  /// Display order
  sort_order          Int     @default(0)

  // --- Relations ---
  salary_structure SalaryStructure @relation(fields: [salary_structure_id], references: [id], onDelete: Cascade)
  salary_component SalaryComponent @relation(fields: [salary_component_id], references: [id], onDelete: Cascade)

  @@unique([salary_structure_id, salary_component_id])
  @@index([salary_structure_id])
  @@map("salary_structure_lines")
}

/// Employee's assigned salary — their specific CTC and structure
model EmployeeSalary {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  employee_id         String   @unique @db.Uuid
  /// Salary structure this employee follows
  salary_structure_id String   @db.Uuid
  /// Annual CTC (Cost to Company)
  annual_ctc          Decimal  @db.Decimal(14, 2)
  /// Monthly gross salary
  monthly_gross       Decimal  @db.Decimal(14, 2)
  /// Monthly net salary (after deductions, before tax)
  monthly_net         Decimal  @db.Decimal(14, 2)
  /// Basic salary (often 40-50% of CTC)
  basic_salary        Decimal  @db.Decimal(14, 2)
  /// Component-wise breakdown as JSON (for quick reference without querying structure)
  component_breakdown Json     @default("{}") @db.JsonB
  /// Whether PF is applicable
  pf_applicable       Boolean  @default(true)
  /// Whether ESI is applicable (gross ≤ ₹21,000/month)
  esi_applicable      Boolean  @default(false)
  /// Whether Professional Tax is applicable
  pt_applicable       Boolean  @default(true)
  /// Tax regime: "old" or "new"
  tax_regime          String   @default("new") @db.VarChar(10)
  /// Effective from date
  effective_from      DateTime @db.Date
  /// Effective until date (null if current)
  effective_until     DateTime? @db.Date
  /// Notes about salary changes
  notes               String?  @db.Text
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // --- Relations ---
  tenant           Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee         Employee        @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  salary_structure SalaryStructure @relation(fields: [salary_structure_id], references: [id], onDelete: Restrict)

  @@index([tenant_id])
  @@index([employee_id])
  @@index([salary_structure_id])
  @@map("employee_salaries")
}

/// Monthly payroll processing batch
model PayrollRun {
  id              String        @id @default(uuid()) @db.Uuid
  tenant_id       String        @db.Uuid
  /// Auto-generated run reference (e.g., "PAY-RUN-2026-03")
  run_number      String        @db.VarChar(50)
  /// Payroll month (1-12)
  month           Int
  /// Payroll year
  year            Int
  /// Period start date
  period_start    DateTime      @db.Date
  /// Period end date
  period_end      DateTime      @db.Date
  /// Processing status
  status          PayrollStatus @default(DRAFT)
  /// Total employees processed
  total_employees Int           @default(0)
  /// Total gross salary
  total_gross     Decimal       @default(0) @db.Decimal(14, 2)
  /// Total deductions
  total_deductions Decimal      @default(0) @db.Decimal(14, 2)
  /// Total net payable
  total_net       Decimal       @default(0) @db.Decimal(14, 2)
  /// Total employer contributions (PF, ESI)
  total_employer_contribution Decimal @default(0) @db.Decimal(14, 2)
  /// Who initiated the payroll run
  processed_by    String?       @db.Uuid
  /// When processing started
  processed_at    DateTime?
  /// Who approved the payroll
  approved_by     String?       @db.Uuid
  /// When approved
  approved_at     DateTime?
  /// When salaries were disbursed
  paid_at         DateTime?
  /// Notes about this payroll run
  notes           String?       @db.Text
  /// Additional metadata
  metadata        Json?         @db.JsonB
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  // --- Relations ---
  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([tenant_id, run_number])
  @@index([tenant_id])
  @@index([month, year])
  @@index([status])
  @@map("payroll_runs")
}

/// Individual employee payslip generated from a payroll run
model Payslip {
  id                 String   @id @default(uuid()) @db.Uuid
  payroll_run_id     String   @db.Uuid
  employee_id        String   @db.Uuid
  /// Auto-generated payslip number (e.g., "PS-2026-03-0001")
  payslip_number     String   @db.VarChar(50)
  /// Month of the payslip
  month              Int
  /// Year of the payslip
  year               Int
  /// Working days in the month
  working_days       Decimal  @db.Decimal(5, 1)
  /// Actual days worked (after leave deductions)
  days_worked        Decimal  @db.Decimal(5, 1)
  /// Leave days taken (LOP + approved)
  leave_days         Decimal  @default(0) @db.Decimal(5, 1)
  /// Days classified as Loss of Pay (unpaid leave)
  lop_days           Decimal  @default(0) @db.Decimal(5, 1)
  /// Total earnings (sum of all earning components)
  total_earnings     Decimal  @db.Decimal(14, 2)
  /// Total deductions (sum of all deduction components)
  total_deductions   Decimal  @db.Decimal(14, 2)
  /// Gross salary for the month
  gross_salary       Decimal  @db.Decimal(14, 2)
  /// Net salary payable
  net_salary         Decimal  @db.Decimal(14, 2)
  /// Employer PF contribution (12% of basic, capped at ₹1,800)
  employer_pf        Decimal  @default(0) @db.Decimal(14, 2)
  /// Employer ESI contribution
  employer_esi       Decimal  @default(0) @db.Decimal(14, 2)
  /// TDS deducted for this month
  tds_deducted       Decimal  @default(0) @db.Decimal(14, 2)
  /// Professional Tax deducted
  professional_tax   Decimal  @default(0) @db.Decimal(14, 2)
  /// PDF download URL for the payslip
  pdf_url            String?  @db.VarChar(500)
  /// Whether the employee has acknowledged/downloaded the payslip
  is_acknowledged    Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  // --- Relations ---
  payroll_run PayrollRun   @relation(fields: [payroll_run_id], references: [id], onDelete: Cascade)
  employee    Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  lines       PayslipLine[]

  @@unique([payroll_run_id, employee_id])
  @@index([payroll_run_id])
  @@index([employee_id])
  @@index([month, year])
  @@map("payslips")
}

/// Individual line item on a payslip (each earning/deduction component)
model PayslipLine {
  id                  String        @id @default(uuid()) @db.Uuid
  payslip_id          String        @db.Uuid
  salary_component_id String        @db.Uuid
  /// Earning or deduction
  component_type      ComponentType
  /// Component display name (denormalized for historical accuracy)
  component_name      String        @db.VarChar(255)
  /// Calculated amount for this component
  amount              Decimal       @db.Decimal(14, 2)
  /// Year-to-date total for this component
  ytd_amount          Decimal       @default(0) @db.Decimal(14, 2)
  /// Display order
  sort_order          Int           @default(0)

  // --- Relations ---
  payslip          Payslip         @relation(fields: [payslip_id], references: [id], onDelete: Cascade)
  salary_component SalaryComponent @relation(fields: [salary_component_id], references: [id], onDelete: Restrict)

  @@index([payslip_id])
  @@map("payslip_lines")
}

// ╔════════════════════════════════════════════════════════════════════════════╗
// ║  PHASE 4: INVENTORY & ORDER MANAGEMENT                                    ║
// ╚════════════════════════════════════════════════════════════════════════════╝

// ============================================================================
// Phase 4 Enums
// ============================================================================

enum ProductType {
  GOODS
  SERVICE
}

enum StockMovementType {
  PURCHASE_IN
  SALES_OUT
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  OPENING_STOCK
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
}

// ==============================================================================
// PHASE 5 ENUMS — E-Learning & Community
// ==============================================================================

/// Course difficulty level
enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Enrollment access type
enum EnrollmentType {
  OPEN
  RESTRICTED
  ASSIGNED
}

/// Enrollment status lifecycle
enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
  EXPIRED
}

/// Lesson content type
enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
  DOWNLOAD
  LIVE_SESSION
}

/// Quiz question type
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

/// Certificate status
enum CertificateStatus {
  ISSUED
  REVOKED
  EXPIRED
}

/// Forum / Discussion post type
enum PostType {
  DISCUSSION
  QUESTION
  ANNOUNCEMENT
  IDEA
  ARTICLE
}

/// Post moderation status
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

// ==============================================================================
// PHASE 6 ENUMS — Partner Program & Marketplace
// ==============================================================================

/// Partner type / engagement model
enum PartnerType {
  RESELLER
  REFERRAL
  TECHNOLOGY
  AFFILIATE
}

/// Partner tier level
enum PartnerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

/// Partner lifecycle status
enum PartnerStatus {
