// ==============================================================================
// SOFTMERCE SaaS-BOS — Prisma Schema
// Phase 1: Foundation & Core Infrastructure
// Phase 2: Billing, CRM & Accounting
// Phase 3: HRMS & Payroll
// Phase 4: Inventory & Order Management
// Phase 5: E-Learning & Community
// Phase 6: Partner Program & Marketplace
// ==============================================================================
// This schema defines all database models for Phase 1–6 including:
//   - Multi-Tenant Management Engine
//   - Authentication & Authorization (RBAC)
//   - Central AI Orchestrator (Foundation)
//   - Settings Framework
//   - Notification Engine
//   - Audit & Compliance Engine
//
// Design Principles:
//   - Row-level tenant isolation (shared tables with tenant_id)
//   - Soft delete support (is_deleted + deleted_at)
//   - Timestamps on all tables (created_at, updated_at)
//   - UUID primary keys for security and distributed compatibility
//   - JSONB fields for flexible/extensible data
//   - Forward-compatible: Placeholder references for Phase 2-6 models
// ==============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==============================================================================
// ENUMS — Centralized status & type definitions
// ==============================================================================

/// Tenant lifecycle status - tracks where the tenant is in their journey
enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

/// Subscription billing status - tracks payment/subscription state
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
}

/// Billing cycle frequency options
enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// User account status - tracks user's access state
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

/// Data visibility scope for RBAC - controls which records a role can see
enum DataScope {
  OWN
  TEAM
  DEPARTMENT
  BRANCH
  ALL
}

/// Notification delivery channel
enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

/// Notification urgency level
enum NotificationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// Notification delivery status - tracks the lifecycle of a notification
enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Setting value data type - for proper parsing and validation
enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ARRAY
}

