// ║  Multi-Agent System, RAG Pipeline, Autonomous Decision Engine, Analytics     ║
// ╚═══════════════════════════════════════════════════════════════════════════════╝

// --- Enums ---

enum AIAgentType {
  SALES
  SUPPORT
  FINANCE
  HR
  LEARNING
  PARTNER
  ORCHESTRATOR
}

enum AIAgentStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum RAGDocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum DecisionType {
  LEAD_ASSIGNMENT
  INVOICE_APPROVAL
  LEAVE_APPROVAL
  PAYMENT_RETRY
  CONTENT_MODERATION
  SUPPORT_ROUTING
  PRICE_ADJUSTMENT
}

enum DecisionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  ROLLED_BACK
}

enum InsightType {
  CUSTOMER_360
  REVENUE_ATTRIBUTION
  EMPLOYEE_COST
  PARTNER_ROI
  CHURN_DRIVERS
  GROWTH_OPPORTUNITIES
}

// ============================================================================
// AIAgent — Multi-Agent System definitions
// ============================================================================
// Each agent is specialized for a module (Sales, Finance, HR, etc.).
// The Orchestrator agent routes requests to the appropriate specialist.
// ============================================================================

model AIAgent {
  id                String         @id @default(uuid()) @db.Uuid
  tenant_id         String         @db.Uuid
  /// Display name (e.g., "Sales Assistant")
  name              String         @db.VarChar(255)
  /// Short code (e.g., "sales_agent")
  code              String         @db.VarChar(100)
  /// Specialization type
  agent_type        AIAgentType
  /// Current operational status
  status            AIAgentStatus  @default(ACTIVE)
  /// Detailed description of agent capabilities
  description       String?        @db.Text
  /// System prompt / persona for the agent
  system_prompt     String         @db.Text
  /// Which AI model to use (e.g., "gpt-4o", "claude-3.5-sonnet")
  model             String         @db.VarChar(100)
  /// Temperature setting (0.0 – 2.0)
  temperature       Float          @default(0.7)
  /// Maximum tokens for response
  max_tokens        Int            @default(4096)
  /// Agent capabilities as structured data
  capabilities      Json           @default("[]") @db.JsonB
  /// Modules this agent can access
  accessible_modules Json          @default("[]") @db.JsonB
  /// Rate limit: max requests per minute per user
  rate_limit_per_min Int           @default(30)
  /// Whether the agent is the default for its type
  is_default        Boolean        @default(false)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  // --- Relations ---
  tenant            Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  conversations     AIConversation[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([agent_type])
  @@index([status])
  @@map("ai_agents")
}

// ============================================================================
// AIConversation — Chat conversations with AI agents
// ============================================================================

model AIConversation {
  id              String              @id @default(uuid()) @db.Uuid
  tenant_id       String              @db.Uuid
  user_id         String              @db.Uuid
  agent_id        String              @db.Uuid
  /// Conversation title (auto-generated or user-provided)
  title           String?             @db.VarChar(500)
  /// Current status of the conversation
  status          ConversationStatus  @default(ACTIVE)
  /// Context gathered for this conversation (module, entity refs)
  context         Json                @default("{}") @db.JsonB
  /// Total tokens used in this conversation
  total_tokens    Int                 @default(0)
  /// Total cost (USD) of this conversation
  total_cost      Decimal             @default(0) @db.Decimal(10, 6)
  /// Number of messages in this conversation
  message_count   Int                 @default(0)
  /// Last message timestamp
  last_message_at DateTime?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  // --- Relations ---
  tenant          Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  agent           AIAgent             @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  messages        AIMessage[]

  @@index([tenant_id])
  @@index([user_id])
  @@index([agent_id])
  @@index([status])
  @@map("ai_conversations")
}

// ============================================================================
// AIMessage — Individual messages in AI conversations
// ============================================================================

model AIMessage {
  id              String       @id @default(uuid()) @db.Uuid
  conversation_id String       @db.Uuid
  user_id         String?      @db.Uuid
  /// Message role: user, assistant, or system
  role            MessageRole
  /// Message content (markdown supported)
  content         String       @db.Text
  /// Tokens used for this message (input + output)
  tokens_used     Int          @default(0)
  /// Cost for this message
  cost            Decimal      @default(0) @db.Decimal(10, 6)
  /// Model used for generation
  model_used      String?      @db.VarChar(100)
  /// Latency in milliseconds
  latency_ms      Int?
  /// Tool calls made by the assistant
  tool_calls      Json?        @db.JsonB
  /// Citations / sources used for the response
  citations       Json?        @db.JsonB
  /// Feedback: thumbs up/down
  feedback        Int?         @db.SmallInt
  created_at      DateTime     @default(now())

  // --- Relations ---
  conversation    AIConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([conversation_id])
  @@index([user_id])
  @@index([role])
  @@map("ai_messages")
}

// ============================================================================
// RAGDocument — Documents ingested for Retrieval Augmented Generation
// ============================================================================

model RAGDocument {
  id              String            @id @default(uuid()) @db.Uuid
  tenant_id       String            @db.Uuid
  /// Document title / filename
  title           String            @db.VarChar(500)
  /// Original file type (pdf, docx, html, txt, csv)
  file_type       String            @db.VarChar(20)
  /// Source URL or file storage path
  source_url      String?           @db.VarChar(1000)
  /// File size in bytes
  file_size_bytes Int?
  /// Which module this document relates to
  module          String?           @db.VarChar(50)
  /// Processing status
  status          RAGDocumentStatus @default(PENDING)
  /// Number of chunks generated from this document
  chunk_count     Int               @default(0)
  /// Total tokens in all chunks
  total_tokens    Int               @default(0)
  /// Metadata (author, tags, category, etc.)
  metadata        Json              @default("{}") @db.JsonB
  /// Error message if processing failed
  error_message   String?           @db.Text
  /// When processing was completed
  processed_at    DateTime?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  // --- Relations ---
  tenant          Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  chunks          RAGChunk[]

  @@index([tenant_id])
  @@index([module])
  @@index([status])
  @@map("rag_documents")
}

// ============================================================================
// RAGChunk — Document chunks with embedding references
// ============================================================================

model RAGChunk {
  id              String       @id @default(uuid()) @db.Uuid
  document_id     String       @db.Uuid
  /// Chunk sequence number within the document
  chunk_index     Int
  /// Text content of the chunk
  content         String       @db.Text
  /// Token count for this chunk
  token_count     Int          @default(0)
  /// Embedding vector ID in external vector DB (Pinecone/Weaviate)
  vector_id       String?      @db.VarChar(255)
  /// Embedding model used
  embedding_model String?      @db.VarChar(100)
  /// Structural metadata (page number, section heading, etc.)
  metadata        Json         @default("{}") @db.JsonB
  created_at      DateTime     @default(now())

  // --- Relations ---
  document        RAGDocument  @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([document_id, chunk_index])
  @@index([document_id])
  @@index([vector_id])
  @@map("rag_chunks")
}

// ============================================================================
// AutonomousRule — Configurable rules for the Autonomous Decision Engine
// ============================================================================

model AutonomousRule {
  id                  String       @id @default(uuid()) @db.Uuid
  tenant_id           String       @db.Uuid
  /// Rule name (e.g., "Auto-approve leave under 3 days")
  name                String       @db.VarChar(255)
  /// Rule description
  description         String?      @db.Text
  /// Which type of decision this rule governs
  decision_type       DecisionType
  /// Module this rule applies to
  module              String       @db.VarChar(50)
  /// Trigger conditions as JSON (e.g., {"amount": {"lt": 50000}})
  conditions          Json         @db.JsonB
  /// Actions to take when conditions are met
  actions             Json         @db.JsonB
  /// Safeguards: amount limits, approval thresholds, etc.
  safeguards          Json         @default("{}") @db.JsonB
  /// Priority (lower = higher priority, evaluated first)
  priority            Int          @default(100)
  /// Whether this rule is currently active
  is_active           Boolean      @default(true)
  /// Minimum AI confidence required to trigger (0.0 – 1.0)
  confidence_threshold Float       @default(0.9)
  /// Maximum executions per day (0 = unlimited)
  daily_limit         Int          @default(0)
  /// Count of times this rule has been executed today
  daily_execution_count Int        @default(0)
  /// Last time the daily counter was reset
  last_reset_at       DateTime     @default(now())
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  // --- Relations ---
  tenant              Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  decisions           AutonomousDecision[]

  @@index([tenant_id])
  @@index([decision_type])
  @@index([module])
  @@index([is_active])
  @@map("autonomous_rules")
}

// ============================================================================
// AutonomousDecision — Log of all autonomous decisions made by the engine
// ============================================================================

model AutonomousDecision {
  id                String         @id @default(uuid()) @db.Uuid
  tenant_id         String         @db.Uuid
  rule_id           String?        @db.Uuid
  /// Decision type classification
  decision_type     DecisionType
  /// Module where decision was made
  module            String         @db.VarChar(50)
  /// Resource type (lead, invoice, leave_request, etc.)
  resource_type     String         @db.VarChar(100)
  /// Resource ID the decision acted upon
  resource_id       String?        @db.Uuid
  /// Current status of the decision
  status            DecisionStatus @default(PENDING)
  /// AI confidence score (0.0 – 1.0)
  confidence        Float?
  /// AI model used for the decision
  model_used        String?        @db.VarChar(100)
  /// Input data used for the decision
  input_data        Json           @default("{}") @db.JsonB
  /// Output / result of the decision
  output_data       Json           @default("{}") @db.JsonB
  /// Human-readable reasoning
  reasoning         String?        @db.Text
  /// Whether human override occurred
  was_overridden    Boolean        @default(false)
  /// Override reason if overridden
  override_reason   String?        @db.Text
  /// When the decision was executed
  executed_at       DateTime?
  /// When the decision was rolled back (if applicable)
  rolled_back_at    DateTime?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  // --- Relations ---
  tenant            Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  rule              AutonomousRule? @relation(fields: [rule_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([rule_id])
  @@index([decision_type])
  @@index([status])
  @@index([module])
  @@map("autonomous_decisions")
}

// ============================================================================
// AnalyticsDashboard — Custom dashboard configurations per user
// ============================================================================

model AnalyticsDashboard {
  id              String            @id @default(uuid()) @db.Uuid
  tenant_id       String            @db.Uuid
  created_by      String            @db.Uuid
  /// Dashboard title
  title           String            @db.VarChar(255)
  /// Dashboard description
  description     String?           @db.Text
  /// Whether this is the default executive dashboard
  is_default      Boolean           @default(false)
  /// Whether this dashboard is shared with all tenant users
  is_shared       Boolean           @default(false)
  /// Layout configuration (grid positions, sizes)
  layout          Json              @default("[]") @db.JsonB
  /// Refresh interval in seconds (0 = manual only)
  refresh_interval Int              @default(300)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  // --- Relations ---
  tenant          Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  creator         User              @relation("DashboardCreator", fields: [created_by], references: [id], onDelete: Cascade)
  widgets         AnalyticsWidget[]

  @@index([tenant_id])
  @@index([created_by])
  @@map("analytics_dashboards")
}

// ============================================================================
// AnalyticsWidget — Individual widgets within a dashboard
// ============================================================================

model AnalyticsWidget {
  id              String              @id @default(uuid()) @db.Uuid
  dashboard_id    String              @db.Uuid
  /// Widget title (e.g., "Revenue Overview", "Sales Pipeline")
  title           String              @db.VarChar(255)
  /// Widget type (chart, kpi, table, list, map)
  widget_type     String              @db.VarChar(50)
  /// Data source module(s) — comma separated
  data_sources    String              @db.VarChar(500)
  /// Insight type for AI-powered cross-module insights
  insight_type    InsightType?
  /// Visualization type (line, bar, pie, funnel, heatmap, etc.)
  visualization   String              @db.VarChar(50)
  /// Query / data configuration
  query_config    Json                @default("{}") @db.JsonB
  /// Display configuration (colors, labels, thresholds, etc.)
  display_config  Json                @default("{}") @db.JsonB
  /// Grid position: row, col, width, height
  position        Json                @default("{}") @db.JsonB
  /// Whether AI enhancement is enabled for this widget
  ai_enhanced     Boolean             @default(false)
  /// AI enhancement config (forecast overlay, anomaly detection, etc.)
  ai_config       Json                @default("{}") @db.JsonB
  /// Sort order within the dashboard
  sort_order      Int                 @default(0)
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  // --- Relations ---
  dashboard       AnalyticsDashboard  @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)

  @@index([dashboard_id])
  @@index([insight_type])
  @@map("analytics_widgets")
}
